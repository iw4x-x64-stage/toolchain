# Prevent git commands from reading the global and system configuration,
# running maintenance tasks, and starting daemons.
#
+export GIT_CONFIG_NOSYSTEM=1
+export GIT_CONFIG_GLOBAL=/dev/null
+export GIT_CONFIG_PARAMETERS="'maintenance.auto=false' 'gc.auto=0' \
'core.fsmonitor=false' 'credential.helper=' 'core.hooksPath=' \
'core.autocrlf=false'"

g = [cmdline] git -c user.name=Committer -c user.email=committer@example.org \
  2>! >&2

# Create the repository and commit everything in it with the specified
# message. Every test names its repository repo.
#
init = [cmdline] $g init --quiet --initial-branch=main
save = [cmdline] $g -C repo add --all && $g -C repo commit --quiet --message

# Run ignorerevs as a user whose git identity is configured.
#
ignorerevs = [cmdline] env GIT_AUTHOR_NAME=Committer \
  GIT_AUTHOR_EMAIL=committer@example.org GIT_COMMITTER_NAME=Committer \
  GIT_COMMITTER_EMAIL=committer@example.org $*

# The file preamble. A test writes the entries it expects into the entries
# file and compares the preamble followed by them to the file.
#
+cat <<'EOI' >=preamble
  # Commits that git-blame(1) skips since they only change formatting. Git
  # reads this file if blame.ignoreRevsFile is set to it and GitHub reads it
  # by default.
  #
  # Generated by ignorerevs, which keeps the commits added by hand.

  EOI

preamble = $~/preamble
file = .git-blame-ignore-revs

: help
:
$* --help 2>>~%EOE%
  %usage: .+ignorerevs \[<options>\] \[<dir>\]%
  %.*%*
  EOE

: version
:
$* --version >~'/ignorerevs \d+\.\d+\.\d+.*/'

: args
:
{{
  : too-many
  :
  $* d x 2>>~%EOE% != 0
    %error: usage: .+ignorerevs \[<options>\] \[<dir>\]%
    EOE

  : unknown-option
  :
  $* --frobnicate 2>'error: unknown option: --frobnicate' != 0

  : push-show-push
  :
  $* --push --show-push 2>'error: both --push and --show-push specified' != 0

  : no-commit-push
  :
  $* --no-commit --push 2>'error: --push specified with --no-commit' != 0

  : dir-not-exist
  :
  $* d 2>"error: 'd' does not exist or is not a directory" != 0

  : dir-not-repository
  :
  {
    mkdir d
    $* d 2>"error: 'd' is not inside a git working tree" != 0
  }
}}

: detect
:
{{
  : whitespace
  :
  : Test that the commits that only change the amount of whitespace, blank
  : lines, or line endings are listed, oldest first, and that the others
  : are not.
  :
  {
    $init repo &repo/***
    printf 'int x;\nint y;\n' >=repo/x.cxx
    $save 'Add x'

    printf '  int x;\nint y;\n' >=repo/x.cxx
    $save 'Indent x'
    git -C repo rev-parse HEAD | set indent

    printf '  int x;\n\nint y;\n' >=repo/x.cxx
    $save 'Separate'
    git -C repo rev-parse HEAD | set separate

    printf '  int x;\r\n\r\nint y;\r\n' >=repo/x.cxx
    $save 'Use CRLF'
    git -C repo rev-parse HEAD | set crlf

    printf '  int  x;\r\n\r\nint y;\r\n' >=repo/x.cxx
    $save 'Space'
    git -C repo rev-parse HEAD | set space

    printf '  int  z;\r\n\r\nint y;\r\n' >=repo/x.cxx
    $save 'Rename'

    printf 'intx;\n' >=repo/y.cxx
    $save 'Add y'
    printf 'int x;\n' >=repo/y.cxx
    $save 'Add a space'

    $g -C repo commit --quiet --allow-empty --message 'Empty'

    $ignorerevs --yes --no-commit repo 2>!

    cat <<"EOI" >=entries
      # Indent x
      $indent
      # Separate
      $separate
      # Use CRLF
      $crlf
      # Space
      $space
      EOI
    cat $preamble entries >=expected
    diff expected repo/$file
  }

  : significant
  :
  : Test that commits that change files in which whitespace is significant
  : are not listed.
  :
  {
    $init repo &repo/***
    printf 'a:\n  b: 1\n' >=repo/x.yml
    printf 'x\n' >=repo/README.md
    printf 'all:\n\techo\n' >=repo/Makefile
    $save 'Add'

    printf 'a:\n    b: 1\n' >=repo/x.yml
    $save 'Reindent YAML'
    printf 'x  \n' >=repo/README.md
    $save 'Break line'
    printf 'all:\n        echo\n' >=repo/Makefile
    $save 'Use spaces'

    $ignorerevs --yes --no-commit repo 2>>~%EOE%
      %'.+repo' has no commits that only change whitespace%
      EOE

    test -f repo/$file == 1
  }

  : merge
  :
  : Test that merges are not considered, while the commits they merge are.
  :
  {
    $init repo &repo/***
    printf 'int x;\n' >=repo/x.cxx
    $save 'Add x'
    $g -C repo checkout --quiet -b topic
    printf '  int x;\n' >=repo/x.cxx
    $save 'Indent x'
    git -C repo rev-parse HEAD | set indent
    $g -C repo checkout --quiet main
    printf 'int y;\n' >=repo/y.cxx
    $save 'Add y'
    $g -C repo merge --quiet --no-ff --no-edit topic

    $ignorerevs --yes --no-commit repo 2>!

    cat <<"EOI" >=entries
      # Indent x
      $indent
      EOI
    cat $preamble entries >=expected
    diff expected repo/$file
  }

  : blame
  :
  : Test that git-blame(1) skips the listed commits with the file.
  :
  {
    $init repo &repo/***
    printf 'int x;\n' >=repo/x.cxx
    $save 'Add x'
    git -C repo rev-parse --short HEAD | set add
    printf '  int x;\n' >=repo/x.cxx
    $save 'Indent x'

    $ignorerevs --yes --no-commit repo 2>!

    git -C repo blame -s --ignore-revs-file $file x.cxx >~"/\\^?$add\\s+1\\)   int x;/"
  }
}}

: entries
:
{{
  : kept
  :
  : Test that commits added by hand are kept, with their names completed and
  : preceded by their subjects.
  :
  {
    $init repo &repo/***
    printf 'int x;\n' >=repo/x.cxx
    $save 'Add x'
    printf 'int x = 0;\n' >=repo/x.cxx
    $save 'Reformat x'
    git -C repo rev-parse HEAD | set reformat
    git -C repo rev-parse --short HEAD | set short

    echo "$short" >=repo/$file
    $save 'Ignore the reformat'

    $ignorerevs --yes --no-commit repo 2>!

    cat <<"EOI" >=entries
      # Reformat x
      $reformat
      EOI
    cat $preamble entries >=expected
    diff expected repo/$file
  }

  : stale
  :
  : Test that commits not in the history are listed and that the file is
  : left alone.
  :
  {
    $init repo &repo/***
    printf 'int x;\n' >=repo/x.cxx
    $save 'Add x'

    cat <<'EOI' >=repo/$file
      # Gone.
      0123456789abcdef0123456789abcdef01234567
      frobnicate
      EOI
    $save 'Ignore'

    $ignorerevs --yes --no-commit repo 2>>~%EOE% != 0
      %error: '.+repo/\.git-blame-ignore-revs' lists commits not in the history of '.+repo'%
        info: 0123456789abcdef0123456789abcdef01234567
        info: frobnicate
        info: remove them or replace them with the rewritten commits
      EOE
  }

  : shallow
  :
  : Test that a shallow clone is refused.
  :
  {
    $init origin &origin/***
    printf 'int x;\n' >=origin/x.cxx
    $g -C origin add x.cxx
    $g -C origin commit --quiet --message 'Add x'
    printf '  int x;\n' >=origin/x.cxx
    $g -C origin commit --quiet --all --message 'Indent x'

    $g clone --quiet --depth 1 "file://$~/origin" repo &repo/***

    $ignorerevs --yes --no-commit repo 2>>~%EOE% != 0
      %error: '.+repo' is a shallow clone, so its history is incomplete%
        info: fetch the complete history with 'git fetch --unshallow'
      EOE
  }

  : symlink
  :
  : Test that a file that is a symbolic link is left alone.
  :
  {
    $init repo &repo/***
    touch revs
    ln -s ../revs repo/$file

    $ignorerevs --yes --no-commit repo 2>>~%EOE% != 0
      %error: '.+repo/\.git-blame-ignore-revs' is a symbolic link%
        info: run ignorerevs in the repository it refers to
      EOE
  }
}}

: update
:
{{

  : up-to-date
  :
  : Test that an up to date file is reported and left alone.
  :
  {
    $init repo &repo/***
    printf 'int x;\n' >=repo/x.cxx
    $save 'Add x'
    printf '  int x;\n' >=repo/x.cxx
    $save 'Indent x'

    $ignorerevs --yes --no-commit repo 2>!

    $ignorerevs --no-commit repo 2>>~%EOE%
      %'.+repo/\.git-blame-ignore-revs' is up to date%
      EOE
  }

  : uncommitted
  :
  : Test that uncommitted changes to the file are not overwritten.
  :
  {
    $init repo &repo/***
    printf 'int x;\n' >=repo/x.cxx
    $save 'Add x'
    printf '  int x;\n' >=repo/x.cxx
    $save 'Indent x'
    echo '# Mine.' >=repo/$file
    $save 'Add file'
    echo '# Changed.' >=repo/$file

    $ignorerevs --yes --no-commit repo 2>>~%EOE% != 0
      %error: '.+repo/\.git-blame-ignore-revs' has uncommitted changes%
      EOE
  }

  : answer
  :
  : Test that without --yes the update needs an answer.
  :
  {
    $init repo &repo/***
    printf 'int x;\n' >=repo/x.cxx
    $save 'Add x'
    printf '  int x;\n' >=repo/x.cxx
    $save 'Indent x'

    $ignorerevs --no-commit repo <'n' 2>! != 0
    test -f repo/$file == 1
  }

  : commit
  :
  : Test that the file, and only it, is committed with the commits it adds
  : listed in the message, and that whatever else is staged stays in the
  : index.
  :
  {
    $init repo &repo/***
    printf 'int x;\n' >=repo/x.cxx
    $save 'Add x'
    printf '  int x;\n' >=repo/x.cxx
    $save 'Indent x'
    git -C repo rev-parse --short HEAD | set indent

    echo 'z' >=repo/z.txt
    $g -C repo add z.txt

    $ignorerevs --yes repo 2>!

    git -C repo log -1 --format='%B' >>"EOO"
      Update $file

        add    $indent Indent x

      EOO

    git -C repo show --name-only --format= HEAD >"$file"
    git -C repo diff --cached --name-only >'z.txt'
  }

  : print-only
  :
  : Test that --print-only prints the plan to stdout and changes nothing.
  :
  {
    $init repo &repo/***
    printf 'int x;\n' >=repo/x.cxx
    $save 'Add x'
    printf '  int x;\n' >=repo/x.cxx
    $save 'Indent x'

    $ignorerevs --print-only repo >>~%EOO%

      %repository:         .+repo%
      history commits:    2
      whitespace commits: 1

      %.*%*
      +# Indent x
      %\+[0-9a-f]{40}%
      EOO

    test -f repo/$file == 1
  }

  : push
  :
  : Test that the commit, and only it, reaches the upstream.
  :
  {
    $g init --quiet --bare remote.git &remote.git/***
    $init repo &repo/***
    printf 'int x;\n' >=repo/x.cxx
    $save 'Add x'
    printf '  int x;\n' >=repo/x.cxx
    $save 'Indent x'
    $g -C repo remote add origin ../remote.git
    $g -C repo push --quiet --set-upstream origin main

    $ignorerevs --yes --push repo 2>!

    git -C remote.git log --format='%s' main >>"EOO"
      Update $file
      Indent x
      Add x
      EOO
  }

  : all
  :
  : Test that a failure in one repository leaves every repository unchanged.
  :
  {
    mkdir ws
    $g init --quiet --initial-branch=main ws/a &ws/a/***
    echo 'frobnicate' >=ws/a/$file
    $g -C ws/a add $file
    $g -C ws/a commit --quiet --message 'Add'

    $g init --quiet --initial-branch=main ws/b &ws/b/***
    printf 'int x;\n' >=ws/b/x.cxx
    $g -C ws/b add x.cxx
    $g -C ws/b commit --quiet --message 'Add x'
    printf '  int x;\n' >=ws/b/x.cxx
    $g -C ws/b commit --quiet --all --message 'Indent x'

    $ignorerevs --all --yes --no-commit ws 2>>~%EOE% != 0
      %error: '.+/ws/a/\.git-blame-ignore-revs' lists commits not in the history of '.+/ws/a'%
        info: frobnicate
        info: remove them or replace them with the rewritten commits
      error: 1 of 2 repositories failed, nothing changed
      EOE

    test -f ws/b/$file == 1
  }
}}
