#! /usr/bin/env bash

# Copyright (c) the IW4x authors (see the AUTHORS file).
# SPDX-License-Identifier: GPL-3.0-only WITH AdditionRef-IW4x-Exception-1.1

# Update the .git-blame-ignore-revs file of git repositories.
#
# The .git-blame-ignore-revs file lists the commits that git-blame(1) skips,
# attributing the lines they touch to the commits before them. Git reads
# the file if blame.ignoreRevsFile is set to it and GitHub reads it by
# default.
#
# The file lists every commit in the history of HEAD that only changes
# whitespace, along with the commits it already lists, so that commits
# added by hand (for example, a reformat that also moves line breaks) are
# kept.
#
# A commit only changes whitespace if it modifies some files and nothing
# else and each file is the same before and after the commit once its lines
# are normalized: the leading and trailing whitespace of each line is
# removed, each run of whitespace within it is replaced with a single space,
# and blank lines are dropped. So a commit that only changes indentation,
# trailing whitespace, the amount of whitespace between words, blank lines,
# or line endings qualifies, while one that adds or removes a space between
# two words does not. Merges are not considered and neither are commits that
# change a file in which whitespace is significant: YAML, Python, Markdown,
# reStructuredText, makefiles, and patches.
#
# Each commit is written as its full object name preceded by a comment with
# its subject, oldest first. An entry that does not name a commit or names a
# commit that is not in the history of HEAD (for example, after the history
# was rewritten) is an error. A repository without such commits and without
# the file is left alone. A shallow clone is an error since its history is
# incomplete.
#
# Options:
#
# --all|-a
#
#   Operate on every repository found under <dir> instead of the one it is in.
#   The search does not descend into a repository working tree, so nested
#   repositories (submodules, repositories checked out inside another one) are
#   never visited. Linked worktrees are skipped as well, since their
#   repository is visited through its main working tree.
#
#   All the repositories are prepared before any of them is changed, so a
#   failure in one leaves them all unchanged, and the changes are confirmed
#   once for all of them. A failure to push one of them does not prevent
#   pushing the rest.
#
# --no-commit
#
#   Don't commit the updated .git-blame-ignore-revs. By default, it is
#   committed and only it is, whatever else is staged. The commit message
#   lists the commits the update adds.
#
# --push
#
#   Push the commit to the upstream of the current branch. To push exactly
#   this commit, the branch must not be ahead of its upstream before the
#   update.
#
# --show-push
#
#   Print the push command instead of executing it. This allows examining the
#   commit before pushing it. Note that the command is printed to stdout.
#
# --print-only
#
#   Print to stdout what would be done without actually doing anything.
#
# --yes|-y
#
#   Don't prompt for confirmation before updating .git-blame-ignore-revs.
#
# Arguments:
#
# <dir>  A directory in the repository working tree or, with --all, the
#        directory to search for repositories. If not specified, the current
#        directory is assumed.
#
usage="usage: $0 [<options>] [<dir>]"

owd="$(pwd)"
trap "{ cd '$owd'; exit 1; }" ERR
set -o errtrace     # Trap in functions and subshells.
set -o pipefail     # Fail if any pipeline command fails.
shopt -s lastpipe   # Execute last pipeline command in the current shell.

function info () { echo "$*" 1>&2; }
function error () { info "error: $*"; exit 1; }

# Trace and run a command, making git diagnostics distinguishable from
# ours.
#
function run () # <cmd> <arg>...
{
  info "+ $*"
  "$@"
}

all=
commit=true
push=
show_push=
print_only=
yes=

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h|--help)
      info "$usage"
      info
      info "Options:"
      info "  --all|-a      Operate on every repository found under <dir>."
      info "  --no-commit   Don't commit the updated .git-blame-ignore-revs."
      info "  --push        Push the commit to the upstream."
      info "  --show-push   Print the push command instead of executing it."
      info "  --print-only  Print what would be done without doing anything."
      info "  --yes|-y      Don't prompt for confirmation before updating."
      info "  --version     Print version and exit."
      info
      info "See the comments at the beginning of $0 for details."
      exit 0
      ;;
    --version)
      echo "ignorerevs @version@"
      exit 0
      ;;
    -a|--all)
      all=true
      shift
      ;;
    --no-commit)
      commit=
      shift
      ;;
    --push)
      push=true
      shift
      ;;
    --show-push)
      show_push=true
      shift
      ;;
    --print-only)
      print_only=true
      shift
      ;;
    -y|--yes)
      yes=true
      shift
      ;;
    # Catch invalid options.
    #
    -*)
      error "unknown option: $1"
      ;;
    # <dir> or end of options.
    #
    *)
      break
      ;;
  esac
done

if [[ "$#" -gt 1 ]]; then
  error "$usage"
fi

if [[ "$push" && "$show_push" ]]; then
  error "both --push and --show-push specified"
fi

if [[ ! "$commit" ]]; then
  if [[ "$push" ]]; then
    error "--push specified with --no-commit"
  fi

  if [[ "$show_push" ]]; then
    error "--show-push specified with --no-commit"
  fi
fi

dir="${1:-$owd}"
dir="${dir%/}"

if [[ ! -d "$dir" ]]; then
  error "'$dir' does not exist or is not a directory"
fi

if ! command -v git >/dev/null; then
  error "unable to execute git: command not found"
fi

# Make sure that git commands fail instead of prompting for
# authentication and don't run maintenance tasks or start daemons.
#
# Note that we keep the credential helpers, since that is how an HTTPS
# push authenticates without a prompt.
#
export GIT_TERMINAL_PROMPT=0

val="\
'maintenance.autoDetach=false' \
'gc.autoDetach=false' \
'core.fsmonitor=false'"

if [[ -n "$GIT_CONFIG_PARAMETERS" ]]; then
  val="$val $GIT_CONFIG_PARAMETERS"
fi

export GIT_CONFIG_PARAMETERS="$val"

# The name of the file and its preamble. The entries follow the preamble.
#
file=".git-blame-ignore-revs"

preamble="\
# Commits that git-blame(1) skips since they only change formatting. Git
# reads this file if blame.ignoreRevsFile is set to it and GitHub reads it
# by default.
#
# Generated by ignorerevs, which keeps the commits added by hand.
"

# Return 0 if whitespace is significant in the file.
#
function significant () # <path>
{
  local b="${1##*/}"

  case "$b" in
    Makefile|makefile|GNUmakefile)
      return 0
      ;;
  esac

  case "${b,,}" in
    *.yml|*.yaml|*.py|*.pyi|*.md|*.markdown|*.rst|*.mk|*.patch|*.diff)
      return 0
      ;;
  esac

  return 1
}

# Print the commits in the history of HEAD whose diff has no changes if all
# whitespace, blank lines, and carriage returns at the end of lines are
# ignored, one per line, newest first. These are the candidates for the
# commits that only change whitespace.
#
# Such a commit gets no summary line, which is how it is recognized.
#
function whitespace_candidates () # <repo>
{
  local r="$1"
  local h s l

  git -C "$r" log --no-merges --format='%H' --shortstat -w \
    --ignore-blank-lines --ignore-cr-at-eol HEAD |
    while IFS= read -r l; do
      if [[ "$l" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
        if [[ -n "$h" && ! "$s" ]]; then
          echo "$h"
        fi

        h="$l"
        s=
      elif [[ -n "$l" ]]; then
        s=true
      fi
    done

  if [[ -n "$h" && ! "$s" ]]; then
    echo "$h"
  fi
}

# Print the blob normalized the way whitespace_only() compares files.
#
function normalize () # <repo> <blob>
{
  git -C "$1" cat-file blob "$2" | LC_ALL=C awk '
  {
    sub(/\r$/, "")
    gsub(/[ \t\f\v]+/, " ")
    sub(/^ /, "")
    sub(/ $/, "")
    if ($0 != "") print
  }'
}

# Return 0 if the commit only changes whitespace in files where it is not
# significant. The comparison happens in the temporary directory.
#
function whitespace_only () # <repo> <commit> <dir>
{
  local r="$1"
  local h="$2"
  local d="$3"

  local rs=()
  git -C "$r" diff-tree -r --no-commit-id --raw -z "$h" | readarray -d '' -t rs

  if [[ "${#rs[@]}" -eq 0 ]]; then
    return 1
  fi

  # Each change is the raw status line followed by the path.
  #
  local j m p
  for ((j = 0; j < "${#rs[@]}"; j += 2)); do
    m=(${rs[$j]})
    p="${rs[$((j + 1))]}"

    # Only a modification of the content qualifies (its status is M and the
    # object names differ).
    #
    if [[ "${m[4]}" != "M" || "${m[2]}" == "${m[3]}" ]] || significant "$p"
    then
      return 1
    fi

    normalize "$r" "${m[2]}" >"$d/a"
    normalize "$r" "${m[3]}" >"$d/b"

    if ! cmp -s "$d/a" "$d/b"; then
      return 1
    fi
  done
}

# The repositories.
#
# The repositories are indexed in the order they are found. Each has its
# own subdirectory of the temporary directory named after its index.
#
repos=()

repo_failed=()     # Preparing or updating the repository failed.
repo_state=()      # File state: current, stale, absent, or none.
repo_commits=()    # Number of commits in the history of HEAD.
repo_detected=()   # Number of whitespace-only commits.
repo_kept=()       # Number of commits listed by hand.
repo_branch=()     # Branch, remote, and upstream branch to push to.
repo_remote=()
repo_merge=()

# Report the error for the repository and mark it as failed. Each
# argument after the first is printed as an info line.
#
function repo_error () # <index> <text> [<info>...]
{
  local i="$1"

  info "error: $2"
  shift 2

  local s
  for s in "$@"; do
    info "  info: $s"
  done

  repo_failed[$i]=true
}

# Add the repository working tree roots found under the directory to
# repos. Do not descend into a working tree and skip linked worktrees.
#
# Note that a working tree root carries .git, which is a directory or,
# for a linked worktree or a submodule, a file.
#
function find_repositories () # <dir>
{
  local d="$1"

  if [[ -e "$d/.git" ]]; then
    local t
    if t="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" &&
       [[ "$t" == "$(realpath "$d")" ]]; then

      local g c
      g="$(git -C "$d" rev-parse --absolute-git-dir)"
      c="$(git -C "$d" rev-parse --path-format=absolute --git-common-dir)"

      if [[ "$g" == "$c" ]]; then
        repos+=("$t")
      else
        info "warning: skipping linked worktree '$t'"
      fi

      return 0
    fi
  fi

  # Note that hidden directories are searched as well, since a
  # repository can be one (for example, .github).
  #
  local s
  for s in "$d"/* "$d"/.[!.]* "$d"/..?*; do
    if [[ -d "$s" && ! -L "$s" && "$(basename "$s")" != ".git" ]]; then
      find_repositories "$s"
    fi
  done
}

# Add the repository working tree roots found under the directory to
# repos. Do not descend into a working tree and skip linked worktrees.
#
# Note that a working tree root carries .git, which is a directory or,
# for a linked worktree or a submodule, a file.
#
function find_repositories () # <dir>
{
  local d="$1"

  if [[ -e "$d/.git" ]]; then
    local t
    if t="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" &&
       [[ "$t" == "$(realpath "$d")" ]]; then

      local g c
      g="$(git -C "$d" rev-parse --absolute-git-dir)"
      c="$(git -C "$d" rev-parse --path-format=absolute --git-common-dir)"

      if [[ "$g" == "$c" ]]; then
        repos+=("$t")
      else
        info "warning: skipping linked worktree '$t'"
      fi

      return 0
    fi
  fi

  # Note that hidden directories are searched as well, since a
  # repository can be one (for example, .github).
  #
  local s
  for s in "$d"/* "$d"/.[!.]* "$d"/..?*; do
    if [[ -d "$s" && ! -L "$s" && "$(basename "$s")" != ".git" ]]; then
      find_repositories "$s"
    fi
  done
}

# Generate the repository .git-blame-ignore-revs into the file and record
# the numbers of commits. Mark the repository as failed if the existing
# file lists a commit that is not in the history of HEAD.
#
function generate () # <index> <file>
{
  local i="$1"
  local f="$2"
  local r="${repos[$i]}"
  local a="$r/$file"

  if [[ "$(git -C "$r" rev-parse --is-shallow-repository)" == "true" ]]; then
    repo_error "$i" "'$r' is a shallow clone, so its history is incomplete" \
      "fetch the complete history with 'git fetch --unshallow'"
    return 0
  fi

  # Establish the order of the commits in the history, oldest first.
  #
  declare -A order=()
  local n=0 h

  if git -C "$r" rev-parse --verify --quiet HEAD >/dev/null; then
    git -C "$r" rev-list --topo-order --reverse HEAD |
      while IFS= read -r h; do
        order["$h"]="$n"
        n=$((n + 1))
      done
  fi

  repo_commits[$i]="$n"

  # Collect the commits that only change whitespace.
  #
  declare -A cs=() # Commits to list.
  local d=0

  local ws=()
  if [[ "$n" -ne 0 ]]; then
    whitespace_candidates "$r" | readarray -t ws
  fi

  for h in "${ws[@]}"; do
    if whitespace_only "$r" "$h" "$tmp_dir/$i"; then
      cs["$h"]=true
      d=$((d + 1))
    fi
  done

  repo_detected[$i]="$d"

  # Keep the commits the file already lists, resolving abbreviated names.
  #
  local k=0 us=() l e
  if [[ -f "$a" ]]; then
    while IFS= read -r l || [[ -n "$l" ]]; do
      l="${l%$'\r'}"
      l="${l#"${l%%[![:space:]]*}"}"
      l="${l%"${l##*[![:space:]]}"}"

      if [[ -z "$l" || "$l" == "#"* ]]; then
        continue
      fi

      if ! e="$(git -C "$r" rev-parse --verify --quiet "$l^{commit}")" ||
         [[ -z "${order[$e]+x}" ]]; then
        us+=("$l")
        continue
      fi

      if [[ -z "${cs[$e]}" ]]; then
        cs["$e"]=true
        k=$((k + 1))
      fi
    done <"$a"
  fi

  repo_kept[$i]="$k"

  if [[ "${#us[@]}" -ne 0 ]]; then
    repo_error "$i" "'$a' lists commits not in the history of '$r'" \
      "${us[@]}" "remove them or replace them with the rewritten commits"
    return 0
  fi

  if [[ "${#cs[@]}" -eq 0 && ! -f "$a" ]]; then
    repo_state[$i]="none"
    return 0
  fi

  # Write the entries in the history order, each preceded by its subject.
  #
  {
    printf '%s\n' "$preamble"

    for h in "${!cs[@]}"; do
      echo "${order[$h]} $h"
    done | sort -n | while read -r n h; do
      echo "# $(git -C "$r" log -1 --format='%s' "$h")"
      echo "$h"
    done
  } >"$f"
}

# Generate the repository .git-blame-ignore-revs and establish its state.
# If it is to be updated, also establish that it can be committed and
# pushed. Mark the repository as failed if any of this fails.
#
function prepare () # <index>
{
  local i="$1"
  local r="${repos[$i]}"
  local a="$r/$file"

  mkdir "$tmp_dir/$i"

  # Installing the file replaces it, which would turn a symbolic link into
  # a copy of its target.
  #
  if [[ -L "$a" ]]; then
    repo_error "$i" "'$a' is a symbolic link" \
      "run ignorerevs in the repository it refers to"
    return 0
  fi

  generate "$i" "$tmp_dir/$i/revs"

  if [[ "${repo_failed[$i]}" || "${repo_state[$i]}" == "none" ]]; then
    return 0
  fi

  if [[ ! -f "$a" ]]; then
    repo_state[$i]="absent"
  elif cmp -s "$tmp_dir/$i/revs" "$a"; then
    repo_state[$i]="current"
  else
    repo_state[$i]="stale"
  fi

  if [[ "${repo_state[$i]}" == "current" ]]; then
    return 0
  fi

  # Refuse to replace uncommitted changes to the file, since they would be
  # lost, and make sure the commit can be made before we change anything.
  #
  if [[ -n "$(git -C "$r" status --porcelain -- "$file")" ]]; then
    repo_error "$i" "'$a' has uncommitted changes"
    return 0
  fi

  if [[ "$commit" ]] && ! git -C "$r" var GIT_COMMITTER_IDENT \
                            >/dev/null 2>&1; then
    repo_error "$i" "no git identity to commit to '$r' with" \
      "configure user.name and user.email"
    return 0
  fi

  if [[ ! "$push" && ! "$show_push" ]]; then
    return 0
  fi

  # Establish where the commit is pushed to.
  #
  # The upstream is pushed to explicitly, whatever push.default says.
  # Since git pushes every commit the branch has that its upstream does
  # not, the branch must not be ahead of its upstream, so the push
  # carries exactly our commit.
  #
  local b rem mg n

  if ! b="$(git -C "$r" symbolic-ref --quiet --short HEAD)"; then
    repo_error "$i" "HEAD of '$r' is detached, so there is no branch to push" \
      "check out a branch or omit --push"
    return 0
  fi

  rem="$(git -C "$r" config --get "branch.$b.remote" || true)"
  mg="$(git -C "$r" config --get "branch.$b.merge" || true)"

  if [[ -z "$rem" || -z "$mg" ]]; then
    repo_error "$i" "branch '$b' of '$r' has no upstream to push to" \
      "set one with 'git branch --set-upstream-to' or omit --push"
    return 0
  fi

  if ! n="$(git -C "$r" rev-list --count '@{upstream}..HEAD' 2>/dev/null)"
  then
    repo_error "$i" "upstream of branch '$b' of '$r' is not fetched" \
      "run 'git fetch $rem' or omit --push"
    return 0
  fi

  if [[ "$n" -ne 0 ]]; then
    repo_error "$i" "branch '$b' of '$r' has unpushed commits" \
      "push them first or omit --push"
    return 0
  fi

  repo_branch[$i]="$b"
  repo_remote[$i]="$rem"
  repo_merge[$i]="$mg"
}

# Print the commits the file lists, one per line in the bytewise order.
#
function entries () # <file>
{
  if [[ -f "$1" ]]; then
    sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$1" | LC_ALL=C sort -u
  fi
}

# Install the generated .git-blame-ignore-revs into the repository and, if
# requested, commit and push it. Mark the repository as failed if the push
# fails.
#
function update () # <index>
{
  local i="$1"
  local r="${repos[$i]}"
  local a="$r/$file"
  local d="$tmp_dir/$i"

  # Compose the commit message, listing the commits the update adds in the
  # message body.
  #
  if [[ "$commit" ]]; then
    entries "$a" >"$d/old"
    entries "$d/revs" >"$d/new"

    local h body=
    LC_ALL=C comm -13 "$d/old" "$d/new" | while IFS= read -r h; do
      body+="  add    $(git -C "$r" log -1 --format='%h %s' "$h")"$'\n'
    done

    {
      echo "Update $file"

      if [[ -n "$body" ]]; then
        echo
        printf '%s' "$body"
      fi
    } >"$d/message"
  fi

  # Install the file with a single rename, so no reader observes it
  # partially written.
  #
  run cp "$d/revs" "$a.tmp"
  run mv -f "$a.tmp" "$a"

  if [[ "$commit" ]]; then
    run git -C "$r" add -- "$file" >&2
    run git -C "$r" commit --quiet --only --file "$d/message" -- "$file" >&2
  fi

  # Push the commit. If this fails (for example, because the upstream
  # has moved on), the commit stays and can be pushed once the branch is
  # brought up to date.
  #
  if [[ "$push" ]]; then
    if ! run git -C "$r" push --quiet "${repo_remote[$i]}" \
         "HEAD:${repo_merge[$i]}" >&2; then
      repo_error "$i" "push of '$r' to '${repo_remote[$i]}' failed" \
        "the $file commit is kept in branch '${repo_branch[$i]}'"
    fi
  fi
}

tmp_dir="$(mktemp -d)"
trap "{ rm -rf '$tmp_dir'; }" EXIT

# Establish the repositories.
#
if [[ "$all" ]]; then
  find_repositories "$dir"

  if [[ "${#repos[@]}" -eq 0 ]]; then
    error "no git repositories found under '$dir'"
  fi
else
  if ! r="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"; then
    error "'$dir' is not inside a git working tree"
  fi

  repos=("$r")
fi

# Prepare every repository before changing any, so that a failure in one
# leaves them all unchanged.
#
failed=0

for ((i = 0; i != "${#repos[@]}"; ++i)); do
  prepare "$i"

  if [[ "${repo_failed[$i]}" ]]; then
    failed=$((failed + 1))
  fi
done

if [[ "$failed" -ne 0 ]]; then
  if [[ "${#repos[@]}" -gt 1 ]]; then
    info "error: $failed of ${#repos[@]} repositories failed, nothing changed"
  fi

  exit 1
fi

# Print what the update is going to do: the repositories whose file is up
# to date or not needed and, for each of the rest, where the commit is
# pushed to and the changes to the file. Also collect the latter in
# pending.
#
pending=()

function plan ()
{
  local i r

  for ((i = 0; i != "${#repos[@]}"; ++i)); do
    r="${repos[$i]}"

    case "${repo_state[$i]}" in
      none)
        echo "'$r' has no commits that only change whitespace"
        continue
        ;;
      current)
        echo "'$r/$file' is up to date"
        continue
        ;;
    esac

    pending+=("$i")

    echo
    echo "repository:         $r"
    echo "history commits:    ${repo_commits[$i]}"
    echo "whitespace commits: ${repo_detected[$i]}"

    if [[ "${repo_kept[$i]}" -ne 0 ]]; then
      echo "commits by hand:    ${repo_kept[$i]}"
    fi

    if [[ "$push" || "$show_push" ]]; then
      echo "push to:            ${repo_remote[$i]} \
${repo_merge[$i]#refs/heads/}"
    fi

    echo

    if [[ "${repo_state[$i]}" == "absent" ]]; then
      sed -e 's/^/+/' "$tmp_dir/$i/revs"
    else
      diff -u --label "a/$file" --label "b/$file" \
        "$r/$file" "$tmp_dir/$i/revs" || true
    fi
  done
}

if [[ "$print_only" ]]; then
  plan
  exit 0
fi

# Show the changes and ask for confirmation.
#
plan 1>&2

if [[ "${#pending[@]}" -eq 0 ]]; then
  exit 0
fi

info

if [[ "${#pending[@]}" -eq 1 ]]; then
  question="update '${repos[${pending[0]}]}/$file'?"
else
  question="update ${#pending[@]} $file files?"
fi

while [[ ! "$yes" ]]; do
  printf '%s [y/n]: ' "$question" 1>&2

  if ! read opt; then
    info
    error "unable to read answer, use --yes to update without asking"
  fi

  case "$opt" in
    y) yes=true ;;
    n) exit 1   ;;
  esac
done

# Update. A failure to push one repository does not prevent updating the
# rest.
#
for i in "${pending[@]}"; do
  update "$i"

  if [[ "${repo_failed[$i]}" ]]; then
    failed=$((failed + 1))
  fi
done

# Print the push commands, quoted so that they can be executed as
# printed.
#
if [[ "$show_push" ]]; then
  for i in "${pending[@]}"; do
    printf '%q ' git -C "${repos[$i]}" push "${repo_remote[$i]}"
    printf '%q\n' "HEAD:${repo_merge[$i]}"
  done
fi

if [[ "$failed" -ne 0 ]]; then
  exit 1
fi
