#! /usr/bin/env bash

# Copyright (c) the IW4x authors (see the AUTHORS file).
# SPDX-License-Identifier: GPL-3.0-only WITH AdditionRef-IW4x-Exception-1.1

# Update the .mailmap file of git repositories from the identity register.
#
# The identities (name and email) a repository history carries are the commit
# authors and the Co-authored-by trailer values. The .mailmap maps each of
# them to the "preferred identity" of the person it belongs to, as recorded in
# the identity register.
#
# The identity register is a manifest list with one manifest per person:
#
#   : 1
#   name: Jane Doe
#   email: jane@example.org
#   alias: J. Doe <jane@old.example.org>
#   alias: <jdoe@example.com>
#
# The name and email values specify the preferred identity. An alias in the
# '<name> <<email>>' form matches the identity with this name and email and in
# the '<<email>>' form every identity with this email. An identity is matched
# the same way git applies a .mailmap entry to it: an alias with a name takes
# precedence and names and emails compare case-insensitively.
#
# The register must attribute each identity to at most one person, which
# holds if:
#
#   - an email, preferred or aliased, belongs to one person
#   - a name at an email belongs to one person
#   - a name alias matches no other person's preferred identity
#   - an alias is not covered by its person's own emails
#
# Every history identity must be attributed. Before the .mailmap is written,
# git-check-mailmap(1) confirms that it maps every identity to its person.
#
# The .mailmap is generated as a whole and replaces the existing one. Changes
# to it belong in the identity register.
#
# Options:
#
# --all|-a
#
#   Operate on every repository found under <dir> instead of the one it is in.
#   The search does not descend into a repository working tree, so nested
#   repositories (submodules, repositories checked out inside another one) are
#   never visited. Linked worktrees are skipped as well, since their
#   repository is visited through its main working tree.
#
#   All the repositories are prepared before any of them is changed, so a
#   failure in one leaves them all unchanged, and the changes are confirmed
#   once for all of them. A failure to push one of them does not prevent
#   pushing the rest.
#
# --check
#
#   Check that the .mailmap is up to date without changing anything. Fail if
#   it differs from the generated one or does not exist.
#
# --commit
#
#   Commit the updated .mailmap. Only the .mailmap is committed, whatever else
#   is staged.
#
# --push
#
#   Push the commit to the upstream of the current branch. Implies --commit.
#   To push exactly this commit, the branch must not be ahead of its upstream
#   before the update.
#
# --yes
#
#   Do not ask for confirmation before updating the .mailmap.
#
# Arguments:
#
# <identities>  The identity register file.
#
# <dir>         A directory in the repository working tree or, with --all,
#               the directory to search for repositories. If not specified,
#               the current directory is assumed.
#
usage="usage: $0 [<options>] <identities> [<dir>]"

owd="$(pwd)"
trap "{ cd '$owd'; exit 1; }" ERR
set -o errtrace     # Trap in functions and subshells.
set -o pipefail     # Fail if any pipeline command fails.
shopt -s lastpipe   # Execute last pipeline command in the current shell.

@import libbutl.bash/manifest-parser@

function info () { echo "$*" 1>&2; }
function error () { info "error: $*"; exit 1; }

# Trace and run a command, making git diagnostics distinguishable from
# ours.
#
function run () # <cmd> <arg>...
{
  info "+ $*"
  "$@"
}

mode=update
all=
commit=
push=
yes=

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h|--help)
      info "$usage"
      info
      info "Options:"
      info "  --all|-a   Operate on every repository found under <dir>."
      info "  --check    Check that .mailmap is up to date without changing it."
      info "  --commit   Commit the updated .mailmap."
      info "  --push     Push the commit to the upstream, implies --commit."
      info "  --yes      Do not ask for confirmation before updating."
      info "  --version  Print version and exit."
      info
      info "See the comments at the beginning of $0 for details."
      exit 0
      ;;
    --version)
      echo "mailmap @version@"
      exit 0
      ;;
    -a|--all)
      all=true
      shift
      ;;
    --check)
      mode=check
      shift
      ;;
    --commit)
      commit=true
      shift
      ;;
    --push)
      commit=true
      push=true
      shift
      ;;
    --yes)
      yes=true
      shift
      ;;
    # Catch invalid options.
    #
    -*)
      error "unknown option: $1"
      ;;
    # <identities> or end of options.
    #
    *)
      break
      ;;
  esac
done

if [[ "$#" -lt 1 || "$#" -gt 2 ]]; then
  error "$usage"
fi

if [[ "$mode" == "check" && "$commit" ]]; then
  if [[ "$push" ]]; then
    error "--push specified with --check"
  fi

  error "--commit specified with --check"
fi

identities="$1"

if [[ ! -f "$identities" ]]; then
  error "'$identities' does not exist or is not a file"
fi

dir="${2:-$owd}"
dir="${dir%/}"

if [[ ! -d "$dir" ]]; then
  error "'$dir' does not exist or is not a directory"
fi

if ! command -v git >/dev/null; then
  error "unable to execute git: command not found"
fi

# Make sure that git commands fail instead of prompting for
# authentication and don't run maintenance tasks or start daemons.
#
# Note that we keep the credential helpers, since that is how an HTTPS
# push authenticates without a prompt.
#
export GIT_TERMINAL_PROMPT=0

val="\
'maintenance.autoDetach=false' \
'gc.autoDetach=false' \
'core.fsmonitor=false'"

if [[ -n "$GIT_CONFIG_PARAMETERS" ]]; then
  val="$val $GIT_CONFIG_PARAMETERS"
fi

export GIT_CONFIG_PARAMETERS="$val"

# The identity register.
#
# People and their aliases are indexed in the order they appear, with an
# empty name for an email alias. The maps are keyed by the lower-cased
# email (email_*) or by the lower-cased name and email joined with a
# newline, which neither can contain (identity_*, preferred_*).
#
people=0
person_name=()
person_email=()

aliases=0
alias_person=()
alias_name=()
alias_email=()

declare -A email_person=()     # Person of a preferred or aliased email.
declare -A email_spelling=()   # Email as spelled in the register.
declare -A identity_alias=()   # Alias of a name alias identity.
declare -A preferred_person=() # Person of a preferred identity.

# Print the map key of the name and email.
#
function key () # <name> <email>
{
  local n="${1,,}"
  local e="${2,,}"

  echo "$n"$'\n'"$e"
}

# Split the identity in the '<name> <<email>>' or '<<email>>' form into
# the id_name and id_email variables, with id_name empty in the latter
# form. Return 1 if the identity is in neither form.
#
function parse_identity () # <identity>
{
  local re='^(([^<>]*[^<>[:space:]])[[:space:]]+)?[<]([^<>[:space:]]+)[>]$'

  if [[ ! "$1" =~ $re ]]; then
    return 1
  fi

  id_name="${BASH_REMATCH[2]}"
  id_email="${BASH_REMATCH[3]}"
}

# Add the person and their aliases to the register. Fail if this
# violates the register rules.
#
function add_person () # <name> <email> <alias>...
{
  local n="$1"
  local e="$2"
  shift 2

  local name_re='^[^<>[:space:]]([^<>]*[^<>[:space:]])?$'
  local email_re='^[^<>@[:space:]]+@[^<>@[:space:]]+$'

  if [[ ! "$n" =~ $name_re ]]; then
    error "invalid name '$n' in '$identities'"
  fi

  if [[ ! "$e" =~ $email_re ]]; then
    error "invalid email '$e' of '$n' in '$identities'"
  fi

  local k="${e,,}"

  if [[ -n "${email_person[$k]+x}" ]]; then
    info "error: email '$e' belongs to multiple people in '$identities'"
    info "  info: '${person_name[${email_person[$k]}]}' and '$n'"
    exit 1
  fi

  local p="$people"

  person_name+=("$n")
  person_email+=("$e")
  email_person["$k"]="$p"
  email_spelling["$k"]="$e"
  preferred_person["$(key "$n" "$e")"]="$p"

  local a o
  for a in "$@"; do
    if ! parse_identity "$a"; then
      error "invalid alias '$a' of '$n' in '$identities'"
    fi

    if [[ -z "$id_name" ]]; then

      # An email alias covers every name at the email.
      #
      k="${id_email,,}"

      if [[ -n "${email_person[$k]+x}" ]]; then
        o="${email_person[$k]}"

        if [[ "$o" -eq "$p" ]]; then
          error "alias '$a' of '$n' repeats their email in '$identities'"
        fi

        info "error: email '$id_email' belongs to multiple people in \
'$identities'"
        info "  info: '${person_name[$o]}' and '$n'"
        exit 1
      fi

      email_person["$k"]="$p"
      email_spelling["$k"]="$id_email"
    else
      if [[ "${id_email,,}" == "${e,,}" ]]; then
        error "alias '$a' of '$n' is covered by their email in '$identities'"
      fi

      k="$(key "$id_name" "$id_email")"

      if [[ -n "${identity_alias[$k]+x}" ]]; then
        o="${alias_person[${identity_alias[$k]}]}"

        info "error: alias '$a' belongs to multiple people in '$identities'"
        info "  info: '${person_name[$o]}' and '$n'"
        exit 1
      fi

      identity_alias["$k"]="$aliases"
    fi

    alias_person+=("$p")
    alias_name+=("$id_name")
    alias_email+=("$id_email")
    aliases=$((aliases + 1))
  done

  people=$((people + 1))
}

# Load the identity register. Fail if it violates the register rules.
#
function load_identities ()
{
  local n v
  local name email named mailed started end
  local as=()

  butl_manifest_parser_start "$identities"

  # The version pair (an empty name) that opens each manifest in the
  # list closes the person before it, and the end of the list closes the
  # last one.
  #
  while true; do
    if IFS=: read -ru "$butl_manifest_parser_ofd" -d '' n v; then
      end=
    else
      n=
      end=true
    fi

    if [[ -z "$n" ]]; then
      if [[ "$started" ]]; then
        if [[ ! "$named" ]]; then
          error "person without name in '$identities'"
        fi

        if [[ ! "$mailed" ]]; then
          error "person '$name' without email in '$identities'"
        fi

        add_person "$name" "$email" "${as[@]}"
      fi

      if [[ "$end" ]]; then
        break
      fi

      name= email= named= mailed= started=
      as=()
      continue
    fi

    started=true

    case "$n" in
      name)
        if [[ "$named" ]]; then
          error "person '$name' has multiple names in '$identities'"
        fi

        name="$v"
        named=true
        ;;
      email)
        if [[ "$mailed" ]]; then
          error "person with email '$email' has multiple emails in \
'$identities'"
        fi

        email="$v"
        mailed=true
        ;;
      alias)
        as+=("$v")
        ;;
      *)
        error "unknown value '$n' in '$identities'"
        ;;
    esac
  done

  butl_manifest_parser_finish

  # Check the name aliases against the complete register.
  #
  # Note that an email alias of one person and a name alias of another
  # may refer to the same email. This is how two people who committed
  # with a shared email are told apart (and git resolves it the same
  # way).
  #
  local i p k a
  for ((i = 0; i != aliases; ++i)); do
    if [[ -z "${alias_name[$i]}" ]]; then
      continue
    fi

    p="${alias_person[$i]}"
    a="${alias_name[$i]} <${alias_email[$i]}>"

    # A name alias takes precedence over an email, so one that matches
    # another person's preferred identity would take their commits away
    # from them.
    #
    k="$(key "${alias_name[$i]}" "${alias_email[$i]}")"

    if [[ -n "${preferred_person[$k]+x}" ]]; then
      info "error: alias '$a' of '${person_name[$p]}' is the preferred \
identity of '${person_name[${preferred_person[$k]}]}'"
      info "  info: in '$identities'"
      exit 1
    fi

    k="${alias_email[$i],,}"

    if [[ -n "${email_person[$k]+x}" && "${email_person[$k]}" -eq "$p" ]]
    then
      error "alias '$a' of '${person_name[$p]}' is covered by their email \
alias in '$identities'"
    fi
  done
}

# Print the distinct identities the repository history carries, one per
# line in the bytewise order. A repository without commits carries none.
#
function history_identities () # <repo>
{
  local r="$1"

  if ! git -C "$r" rev-parse --verify --quiet HEAD >/dev/null; then
    return 0
  fi

  {
    git -C "$r" log --format='%an <%ae>' HEAD
    git -C "$r" log \
      --format='%(trailers:key=Co-authored-by,valueonly,unfold)' HEAD
  } | sed -e '/^$/d' | LC_ALL=C sort -u
}

# The repositories.
#
# The repositories are indexed in the order they are found. Each has its
# own subdirectory of the temporary directory named after its index.
#
repos=()

repo_failed=()     # Preparing or updating the repository failed.
repo_state=()      # .mailmap state: current, stale, or absent.
repo_identities=() # Number of history identities.
repo_mapped=()     # Number of history identities the .mailmap maps.
repo_branch=()     # Branch, remote, and upstream branch to push to.
repo_remote=()
repo_merge=()

# Report the error for the repository and mark it as failed. Each
# argument after the first is printed as an info line.
#
function repo_error () # <index> <text> [<info>...]
{
  local i="$1"

  info "error: $2"
  shift 2

  local s
  for s in "$@"; do
    info "  info: $s"
  done

  repo_failed[$i]=true
}

# Add the repository working tree roots found under the directory to
# repos. Do not descend into a working tree and skip linked worktrees.
#
# Note that a working tree root carries .git, which is a directory or,
# for a linked worktree or a submodule, a file.
#
function find_repositories () # <dir>
{
  local d="$1"

  if [[ -e "$d/.git" ]]; then
    local t
    if t="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" &&
       [[ "$t" == "$(realpath "$d")" ]]; then

      local g c
      g="$(git -C "$d" rev-parse --absolute-git-dir)"
      c="$(git -C "$d" rev-parse --path-format=absolute --git-common-dir)"

      if [[ "$g" == "$c" ]]; then
        repos+=("$t")
      else
        info "warning: skipping linked worktree '$t'"
      fi

      return 0
    fi
  fi

  # Note that hidden directories are searched as well, since a
  # repository can be one (for example, .github).
  #
  local s
  for s in "$d"/* "$d"/.[!.]* "$d"/..?*; do
    if [[ -d "$s" && ! -L "$s" && "$(basename "$s")" != ".git" ]]; then
      find_repositories "$s"
    fi
  done
}

# Generate the repository .mailmap into the file and record the numbers
# of its history identities and of those that git maps with it. Mark the
# repository as failed if the register does not attribute some history
# identity.
#
# The .mailmap has an entry for each name alias a history identity
# matches and for each email a history identity carries under a name or
# spelling that differs from its person's preferred identity. The
# entries are unique and in the bytewise order, so the same history and
# register always produce the same file.
#
function generate () # <index> <file>
{
  local i="$1"
  local f="$2"
  local r="${repos[$i]}"

  local es=() # Entries.
  local us=() # Unattributed identities.
  local qs=() # Identities git is queried with.
  local ws=() # Preferred identities git must answer with.

  local hs=()
  history_identities "$r" | readarray -t hs

  repo_identities[$i]="${#hs[@]}"

  local h k p j
  for h in "${hs[@]}"; do

    # The Co-authored-by value is recorded as written, so it may not be
    # an identity at all, and then neither we nor git can map it.
    #
    if ! parse_identity "$h" || [[ -z "$id_name" ]]; then
      info "warning: '$h' in the history of '$r' is not an identity"
      continue
    fi

    k="$(key "$id_name" "$id_email")"

    if [[ -n "${identity_alias[$k]+x}" ]]; then
      j="${identity_alias[$k]}"
      p="${alias_person[$j]}"

      es+=("${person_name[$p]} <${person_email[$p]}> \
${alias_name[$j]} <${alias_email[$j]}>")

    elif [[ -n "${email_person[${id_email,,}]+x}" ]]; then
      p="${email_person[${id_email,,}]}"

      if [[ "$id_name"  != "${person_name[$p]}" ||
            "$id_email" != "${person_email[$p]}" ]]; then
        es+=("${person_name[$p]} <${person_email[$p]}> \
<${email_spelling[${id_email,,}]}>")
      fi
    else
      us+=("$h")
      continue
    fi

    qs+=("$h")
    ws+=("${person_name[$p]} <${person_email[$p]}>")
  done

  if [[ "${#us[@]}" -ne 0 ]]; then
    repo_error "$i" "history of '$r' has identities not in '$identities'" \
      "${us[@]}"
    return 0
  fi

  {
    echo "# Generated from the identity register by mailmap."

    if [[ "${#es[@]}" -ne 0 ]]; then
      printf '%s\n' "${es[@]}" | LC_ALL=C sort -u
    fi
  } >"$f"

  repo_mapped[$i]="${#qs[@]}"

  if [[ "${#qs[@]}" -eq 0 ]]; then
    return 0
  fi

  # Query git in an empty repository that ignores the global and system
  # configuration, so the generated file is the only mailmap it reads.
  #
  # Note that a mismatch means the .mailmap generation itself is wrong
  # and nothing is changed in any repository.
  #
  local d="$tmp_dir/$i/check"

  GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git init --quiet "$d"
  cp "$f" "$d/.mailmap"

  local rs=()
  printf '%s\n' "${qs[@]}" |
    GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git -C "$d" check-mailmap --stdin | readarray -t rs

  local n
  for ((n = 0; n != "${#qs[@]}"; ++n)); do
    if [[ "${rs[$n]}" != "${ws[$n]}" ]]; then
      info "error: generated .mailmap maps '${qs[$n]}' to '${rs[$n]}'"
      info "  info: '$identities' attributes it to '${ws[$n]}'"
      exit 1
    fi
  done
}

# Generate the repository .mailmap and establish its state. If it is to
# be updated, also establish that it can be committed and pushed. Mark
# the repository as failed if any of this fails.
#
function prepare () # <index>
{
  local i="$1"
  local r="${repos[$i]}"
  local m="$r/.mailmap"

  mkdir "$tmp_dir/$i"

  generate "$i" "$tmp_dir/$i/mailmap"

  if [[ "${repo_failed[$i]}" ]]; then
    return 0
  fi

  if [[ ! -f "$m" ]]; then
    repo_state[$i]="absent"
  elif cmp -s "$tmp_dir/$i/mailmap" "$m"; then
    repo_state[$i]="current"
  else
    repo_state[$i]="stale"
  fi

  if [[ "$mode" == "check" || "${repo_state[$i]}" == "current" ]]; then
    return 0
  fi

  # Refuse to replace uncommitted changes to the .mailmap, since they
  # would be lost, and make sure the commit can be made before we change
  # anything.
  #
  if [[ -n "$(git -C "$r" status --porcelain -- .mailmap)" ]]; then
    repo_error "$i" "'$m' has uncommitted changes"
    return 0
  fi

  if [[ "$commit" ]] && ! git -C "$r" var GIT_COMMITTER_IDENT \
                            >/dev/null 2>&1; then
    repo_error "$i" "no git identity to commit to '$r' with" \
      "configure user.name and user.email"
    return 0
  fi

  if [[ ! "$push" ]]; then
    return 0
  fi

  # Establish where the commit is pushed to.
  #
  # The upstream is pushed to explicitly, whatever push.default says.
  # Since git pushes every commit the branch has that its upstream does
  # not, the branch must not be ahead of its upstream, so the push
  # carries exactly our commit.
  #
  local b rem mg n

  if ! b="$(git -C "$r" symbolic-ref --quiet --short HEAD)"; then
    repo_error "$i" "HEAD of '$r' is detached, so there is no branch to push" \
      "check out a branch or omit --push"
    return 0
  fi

  rem="$(git -C "$r" config --get "branch.$b.remote" || true)"
  mg="$(git -C "$r" config --get "branch.$b.merge" || true)"

  if [[ -z "$rem" || -z "$mg" ]]; then
    repo_error "$i" "branch '$b' of '$r' has no upstream to push to" \
      "set one with 'git branch --set-upstream-to' or omit --push"
    return 0
  fi

  if ! n="$(git -C "$r" rev-list --count '@{upstream}..HEAD' 2>/dev/null)"
  then
    repo_error "$i" "upstream of branch '$b' of '$r' is not fetched" \
      "run 'git fetch $rem' or omit --push"
    return 0
  fi

  if [[ "$n" -ne 0 ]]; then
    repo_error "$i" "branch '$b' of '$r' has unpushed commits" \
      "push them first or omit --push"
    return 0
  fi

  repo_branch[$i]="$b"
  repo_remote[$i]="$rem"
  repo_merge[$i]="$mg"
}

# Print the entries of the .mailmap file, one per line in the bytewise
# order, skipping comments and blank lines.
#
function entries () # <file>
{
  if [[ -f "$1" ]]; then
    sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$1" | LC_ALL=C sort -u
  fi
}

# Install the generated .mailmap into the repository and, if requested,
# commit and push it. Mark the repository as failed if the push fails.
#
function update () # <index>
{
  local i="$1"
  local r="${repos[$i]}"
  local m="$r/.mailmap"
  local d="$tmp_dir/$i"

  # Compose the commit message, listing the entries the update adds and
  # removes in the message body.
  #
  if [[ "$commit" ]]; then
    entries "$m" >"$d/old"
    entries "$d/mailmap" >"$d/new"

    local body
    body="$(
      LC_ALL=C comm -13 "$d/old" "$d/new" | sed -e 's/^/  add    /'
      LC_ALL=C comm -23 "$d/old" "$d/new" | sed -e 's/^/  remove /'
    )"

    {
      echo "Update .mailmap"

      if [[ -n "$body" ]]; then
        echo
        echo "$body"
      fi
    } >"$d/message"
  fi

  # Install the .mailmap with a single rename, so no reader observes it
  # partially written.
  #
  run cp "$d/mailmap" "$m.tmp"
  run mv -f "$m.tmp" "$m"

  if [[ "$commit" ]]; then
    run git -C "$r" add -- .mailmap >&2
    run git -C "$r" commit --quiet --only --file "$d/message" -- .mailmap >&2
  fi

  # Push the commit. If this fails (for example, because the upstream
  # has moved on), the commit stays and can be pushed once the branch is
  # brought up to date.
  #
  if [[ "$push" ]]; then
    if ! run git -C "$r" push --quiet "${repo_remote[$i]}" \
         "HEAD:${repo_merge[$i]}" >&2; then
      repo_error "$i" "push of '$r' to '${repo_remote[$i]}' failed" \
        "the .mailmap commit is kept in branch '${repo_branch[$i]}'"
    fi
  fi
}

tmp_dir="$(mktemp -d)"
trap "{ rm -rf '$tmp_dir'; }" EXIT

# Establish the repositories.
#
if [[ "$all" ]]; then
  find_repositories "$dir"

  if [[ "${#repos[@]}" -eq 0 ]]; then
    error "no git repositories found under '$dir'"
  fi
else
  if ! r="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"; then
    error "'$dir' is not inside a git working tree"
  fi

  repos=("$r")
fi

load_identities

# Prepare every repository before changing any, so that a failure in one
# leaves them all unchanged.
#
failed=0

for ((i = 0; i != "${#repos[@]}"; ++i)); do
  prepare "$i"

  if [[ "${repo_failed[$i]}" ]]; then
    failed=$((failed + 1))
  fi
done

if [[ "$failed" -ne 0 ]]; then
  if [[ "${#repos[@]}" -gt 1 ]]; then
    info "error: $failed of ${#repos[@]} repositories failed, nothing changed"
  fi

  exit 1
fi

# Check.
#
if [[ "$mode" == "check" ]]; then
  for ((i = 0; i != "${#repos[@]}"; ++i)); do
    if [[ "${repo_state[$i]}" != "current" ]]; then
      info "error: '${repos[$i]}/.mailmap' is ${repo_state[$i]}"
      info "  info: run $(basename "$0") without --check to update it"
      failed=$((failed + 1))
    fi
  done

  if [[ "$failed" -ne 0 ]]; then
    exit 1
  fi

  exit 0
fi

# Show the changes and ask for confirmation.
#
pending=()

for ((i = 0; i != "${#repos[@]}"; ++i)); do
  if [[ "${repo_state[$i]}" == "current" ]]; then
    info "'${repos[$i]}/.mailmap' is up to date"
    continue
  fi

  pending+=("$i")

  info
  info "repository:         ${repos[$i]}"
  info "history identities: ${repo_identities[$i]} (${repo_mapped[$i]} mapped)"

  if [[ "$push" ]]; then
    info "push to:            ${repo_remote[$i]} ${repo_merge[$i]#refs/heads/}"
  fi

  info

  if [[ "${repo_state[$i]}" == "absent" ]]; then
    sed -e 's/^/+/' "$tmp_dir/$i/mailmap" 1>&2
  else
    diff -u --label "a/.mailmap" --label "b/.mailmap" \
      "${repos[$i]}/.mailmap" "$tmp_dir/$i/mailmap" 1>&2 || true
  fi
done

if [[ "${#pending[@]}" -eq 0 ]]; then
  exit 0
fi

info

if [[ "${#pending[@]}" -eq 1 ]]; then
  question="update '${repos[${pending[0]}]}/.mailmap'?"
else
  question="update ${#pending[@]} .mailmap files?"
fi

while [[ ! "$yes" ]]; do
  printf '%s [y/n]: ' "$question" 1>&2

  if ! read opt; then
    info
    error "unable to read answer, use --yes to update without asking"
  fi

  case "$opt" in
    y) yes=true ;;
    n) exit 1   ;;
  esac
done

# Update. A failure to push one repository does not prevent updating the
# rest.
#
for i in "${pending[@]}"; do
  update "$i"

  if [[ "${repo_failed[$i]}" ]]; then
    failed=$((failed + 1))
  fi
done

if [[ "$failed" -ne 0 ]]; then
  exit 1
fi
