# Prevent git commands from reading the global and system configuration,
# running maintenance tasks, and starting daemons.
#
+export GIT_CONFIG_NOSYSTEM=1
+export GIT_CONFIG_GLOBAL=/dev/null
+export GIT_CONFIG_PARAMETERS="'maintenance.auto=false' 'gc.auto=0' \
'core.fsmonitor=false' 'credential.helper=' 'core.hooksPath='"

g = [cmdline] git -c user.name=Committer -c user.email=committer@example.org \
  2>! >&2

# Create the repository and commit to it with the specified author (and,
# optionally, trailers). Every test names its repository repo.
#
init = [cmdline] $g init --quiet --initial-branch=main
commit = [cmdline] $g -C repo commit --quiet --allow-empty --message 'Commit'

# Run mailmap as a user whose git identity is configured.
#
mailmap = [cmdline] env GIT_AUTHOR_NAME=Committer \
  GIT_AUTHOR_EMAIL=committer@example.org GIT_COMMITTER_NAME=Committer \
  GIT_COMMITTER_EMAIL=committer@example.org $*

header = '# Generated from the identity register by mailmap.'

: help
:
$* --help 2>>~%EOE%
  %usage: .+mailmap \[<options>\] <identities> \[<dir>\]%
  %.*%*
  EOE

: version
:
$* --version >~'/mailmap \d+\.\d+\.\d+.*/'

: args
:
{{
  : none
  :
  $* 2>>~%EOE% != 0
    %error: usage: .+mailmap \[<options>\] <identities> \[<dir>\]%
    EOE

  : too-many
  :
  $* r d x 2>>~%EOE% != 0
    %error: usage: .+mailmap \[<options>\] <identities> \[<dir>\]%
    EOE

  : unknown-option
  :
  $* --frobnicate r 2>'error: unknown option: --frobnicate' != 0

  : all-dir-not-exist
  :
  {
    touch r
    $* --all r d 2>"error: 'd' does not exist or is not a directory" != 0
  }

  : identities-not-exist
  :
  $* r 2>"error: 'r' does not exist or is not a file" != 0

  : dir-not-exist
  :
  {
    touch r
    $* r d 2>"error: 'd' does not exist or is not a directory" != 0
  }

  : dir-not-repository
  :
  {
    touch r
    mkdir d
    $* r d 2>"error: 'd' is not inside a git working tree" != 0
  }
}}

: register
:
{{
  : no-name
  :
  {
    cat <<'EOI' >=r
      : 1
      email: jane@example.org
      EOI
    $init repo &repo/***
    $* r repo 2>"error: person without name in 'r'" != 0
  }

  : no-email
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      EOI
    $init repo &repo/***
    $* r repo 2>"error: person 'Jane Doe' without email in 'r'" != 0
  }

  : multiple-names
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      name: Jane
      email: jane@example.org
      EOI
    $init repo &repo/***
    $* r repo 2>"error: person 'Jane Doe' has multiple names in 'r'" != 0
  }

  : multiple-emails
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane@example.org
      email: jane@example.com
      EOI
    $init repo &repo/***
    $* r repo 2>"error: person with email 'jane@example.org' has multiple emails in 'r'" != 0
  }

  : unknown-value
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane@example.org
      github: jdoe
      EOI
    $init repo &repo/***
    $* r repo 2>"error: unknown value 'github' in 'r'" != 0
  }

  : invalid-name
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane <Doe>
      email: jane@example.org
      EOI
    $init repo &repo/***
    $* r repo 2>"error: invalid name 'Jane <Doe>' in 'r'" != 0
  }

  : invalid-email
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane
      EOI
    $init repo &repo/***
    $* r repo 2>"error: invalid email 'jane' of 'Jane Doe' in 'r'" != 0
  }

  : invalid-alias
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane@example.org
      alias: jdoe@example.com
      EOI
    $init repo &repo/***
    $* r repo 2>"error: invalid alias 'jdoe@example.com' of 'Jane Doe' in 'r'" != 0
  }

  : shared-email
  :
  : Test that an email belongs to one person, whatever its case.
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane@example.org
      :
      name: John Roe
      email: Jane@Example.org
      EOI
    $init repo &repo/***
    $* r repo 2>>EOE != 0
      error: email 'Jane@Example.org' belongs to multiple people in 'r'
        info: 'Jane Doe' and 'John Roe'
      EOE
  }

  : shared-email-alias
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane@example.org
      :
      name: John Roe
      email: john@example.org
      alias: <jane@example.org>
      EOI
    $init repo &repo/***
    $* r repo 2>>EOE != 0
      error: email 'jane@example.org' belongs to multiple people in 'r'
        info: 'Jane Doe' and 'John Roe'
      EOE
  }

  : shared-name-alias
  :
  : Test that a name at an email belongs to one person, whatever its case.
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane@example.org
      alias: JD <shared@example.org>
      :
      name: John Roe
      email: john@example.org
      alias: jd <shared@example.org>
      EOI
    $init repo &repo/***
    $* r repo 2>>EOE != 0
      error: alias 'jd <shared@example.org>' belongs to multiple people in 'r'
        info: 'Jane Doe' and 'John Roe'
      EOE
  }

  : own-email
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane@example.org
      alias: <Jane@example.org>
      EOI
    $init repo &repo/***
    $* r repo 2>"error: alias '<Jane@example.org>' of 'Jane Doe' repeats their email in 'r'" != 0
  }

  : own-email-name
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane@example.org
      alias: Jane <jane@example.org>
      EOI
    $init repo &repo/***
    $* r repo 2>"error: alias 'Jane <jane@example.org>' of 'Jane Doe' is covered by their email in 'r'" != 0
  }

  : own-email-alias
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane@example.org
      alias: JD <jd@example.com>
      alias: <jd@example.com>
      EOI
    $init repo &repo/***
    $* r repo 2>"error: alias 'JD <jd@example.com>' of 'Jane Doe' is covered by their email alias in 'r'" != 0
  }

  : preferred-identity
  :
  : Test that a name alias cannot take another person's commits.
  :
  {
    cat <<'EOI' >=r
      : 1
      name: Jane Doe
      email: jane@example.org
      alias: John Roe <john@example.org>
      :
      name: John Roe
      email: john@example.org
      EOI
    $init repo &repo/***
    $* r repo 2>>EOE != 0
      error: alias 'John Roe <john@example.org>' of 'Jane Doe' is the preferred identity of 'John Roe'
        info: in 'r'
      EOE
  }
}}

: generate
:
{{
  +cat <<'EOI' >=r
    : 1
    name: Jane Doe
    email: jane@example.org
    alias: J. Doe <jane@old.example.org>
    alias: <jdoe@example.com>
    :
    name: John Roe
    email: john@example.org
    alias: John <shared@example.org>
    :
    name: Rick Poe
    email: rick@example.org
    alias: <shared@example.org>
    EOI

  : no-commits
  :
  : Test that a repository without commits gets a .mailmap without entries.
  :
  {
    $init repo &repo/***
    $* --yes ../r repo 2>!
    cat repo/.mailmap >$header
  }

  : preferred
  :
  : Test that the preferred identity needs no entry.
  :
  {
    $init repo &repo/***
    $commit --author 'Jane Doe <jane@example.org>'
    $* --yes ../r repo 2>!
    cat repo/.mailmap >$header
  }

  : aliases
  :
  : Test that every alias form is mapped to its person, with the email of an
  : email alias spelled as in the register.
  :
  {
    $init repo &repo/***
    $commit --author 'jane <jane@example.org>'
    $commit --author 'J. Doe <jane@old.example.org>'
    $commit --author 'JD <JDoe@Example.com>'
    $* --yes ../r repo 2>!

    cat repo/.mailmap >>"EOO"
      $header
      Jane Doe <jane@example.org> <jane@example.org>
      Jane Doe <jane@example.org> <jdoe@example.com>
      Jane Doe <jane@example.org> J. Doe <jane@old.example.org>
      EOO

    git -C repo log --use-mailmap --format='%aN <%aE>' >>EOO
      Jane Doe <jane@example.org>
      Jane Doe <jane@example.org>
      Jane Doe <jane@example.org>
      EOO
  }

  : shared-email
  :
  : Test that two people who committed with one email are told apart.
  :
  {
    $init repo &repo/***
    $commit --author 'John <shared@example.org>'
    $commit --author 'Rick <shared@example.org>'
    $* --yes ../r repo 2>!

    git -C repo log --use-mailmap --format='%aN <%aE>' >>EOO
      Rick Poe <rick@example.org>
      John Roe <john@example.org>
      EOO
  }

  : co-author
  :
  : Test that Co-authored-by trailers contribute identities.
  :
  {
    $init repo &repo/***
    $commit --author 'Jane Doe <jane@example.org>' \
      --trailer 'Co-authored-by: J. Doe <jane@old.example.org>'
    $* --yes ../r repo 2>!

    cat repo/.mailmap >>"EOO"
      $header
      Jane Doe <jane@example.org> J. Doe <jane@old.example.org>
      EOO
  }

  : subdirectory
  :
  : Test that a directory inside the working tree names its repository.
  :
  {
    $init repo &repo/***
    mkdir repo/sub
    $commit --author 'jane <jane@example.org>'
    $* --yes ../r repo/sub 2>!

    cat repo/.mailmap >>"EOO"
      $header
      Jane Doe <jane@example.org> <jane@example.org>
      EOO
  }

  : unattributed
  :
  : Test that identities the register does not attribute are listed and that
  : the .mailmap is left alone.
  :
  {
    $init repo &repo/***
    $commit --author 'Stranger <stranger@example.net>'
    $commit --author 'Jane Doe <jane@example.org>'

    $* --yes ../r repo 2>>~%EOE% != 0
      %error: history of '.+repo' has identities not in '../r'%
        info: Stranger <stranger@example.net>
      EOE

    test -f repo/.mailmap == 1
  }

  : up-to-date
  :
  : Test that an up to date .mailmap is reported and left alone.
  :
  {
    $init repo &repo/***
    $commit --author 'jane <jane@example.org>'
    $* --yes ../r repo 2>!

    $* ../r repo 2>>~%EOE%
      %'.+repo/\.mailmap' is up to date%
      EOE
  }

  : uncommitted
  :
  : Test that uncommitted changes to the .mailmap are not overwritten.
  :
  {
    $init repo &repo/***
    $commit --author 'jane <jane@example.org>'
    echo '# Mine.' >=repo/.mailmap

    $* --yes ../r repo 2>>~%EOE% != 0
      %error: '.+repo/\.mailmap' has uncommitted changes%
      EOE

    cat repo/.mailmap >'# Mine.'
  }

  : answer
  :
  : Test that without --yes the update needs an answer.
  :
  {
    $init repo &repo/***
    $commit --author 'jane <jane@example.org>'

    $* ../r repo <'n' 2>! != 0
    test -f repo/.mailmap == 1

    $* ../r repo <'y' 2>!
    test -f repo/.mailmap
  }

  : no-answer
  :
  : Test that the update fails if there is nobody to answer.
  :
  {
    $init repo &repo/***
    $commit --author 'jane <jane@example.org>'

    $* ../r repo <:'' 2>>~%EOE% != 0
      %.*%*
      error: unable to read answer, use --yes to update without asking
      EOE
  }

  : commit
  :
  : Test that --commit commits only the .mailmap, listing the entries it adds
  : and removes in the message, and leaves whatever else is staged in the
  : index.
  :
  {
    $init repo &repo/***
    $commit --author 'jane <jane@example.org>'

    echo 'Jane Doe <jane@example.org> <jane@gone.example.org>' >=repo/.mailmap
    $g -C repo add .mailmap
    $g -C repo commit --quiet --message 'Add .mailmap' \
      --author 'Jane Doe <jane@example.org>'

    echo 'x' >=repo/x
    $g -C repo add x

    $mailmap --yes --commit ../r repo 2>!

    git -C repo log -1 --format='%B' >>EOO
      Update .mailmap

        add    Jane Doe <jane@example.org> <jane@example.org>
        remove Jane Doe <jane@example.org> <jane@gone.example.org>

      EOO

    git -C repo show --name-only --format= HEAD >'.mailmap'
    git -C repo diff --cached --name-only >'x'
  }

  : commit-header
  :
  : Test that a commit that only rewrites comments has no message body.
  :
  {
    $init repo &repo/***
    $commit --author 'Jane Doe <jane@example.org>'

    echo '# Hand-written.' >=repo/.mailmap
    $g -C repo add .mailmap
    $g -C repo commit --quiet --message 'Add .mailmap' \
      --author 'Jane Doe <jane@example.org>'

    $mailmap --yes --commit ../r repo 2>!

    git -C repo log -1 --format='%B' >>EOO
      Update .mailmap

      EOO
  }

  : push
  :
  {{
    # Create the upstream repository and the repository tracking it, with
    # one commit pushed.
    #
    upstream = [cmdline] $g init --quiet --bare remote.git
    track = [cmdline] $g -C repo remote add origin ../remote.git
    publish = [cmdline] $g -C repo push --quiet --set-upstream origin main

    : success
    :
    : Test that the .mailmap commit, and only it, reaches the upstream.
    :
    {
      $upstream &remote.git/***
      $init repo &repo/***
      $commit --author 'jane <jane@example.org>'
      $track
      $publish

      $mailmap --yes --push ../../r repo 2>!

      git -C remote.git log --format='%s' main >>EOO
        Update .mailmap
        Commit
        EOO

      git -C repo rev-list --count '@{upstream}..HEAD' >'0'
    }

    : no-upstream
    :
    : Test that a branch without an upstream is refused before anything
    : changes.
    :
    {
      $init repo &repo/***
      $commit --author 'jane <jane@example.org>'

      $mailmap --yes --push ../../r repo 2>>"EOE" != 0
        error: branch 'main' of '$~/repo' has no upstream to push to
          info: set one with 'git branch --set-upstream-to' or omit --push
        EOE

      test -f repo/.mailmap == 1
    }

    : detached
    :
    : Test that a detached HEAD is refused before anything changes.
    :
    {
      $init repo &repo/***
      $commit --author 'jane <jane@example.org>'
      $g -C repo checkout --quiet --detach

      $mailmap --yes --push ../../r repo 2>>"EOE" != 0
        error: HEAD of '$~/repo' is detached, so there is no branch to push
          info: check out a branch or omit --push
        EOE

      test -f repo/.mailmap == 1
    }

    : ahead
    :
    : Test that a branch with unpushed commits is refused, so that the push
    : never publishes commits other than the .mailmap one.
    :
    {
      $upstream &remote.git/***
      $init repo &repo/***
      $commit --author 'jane <jane@example.org>'
      $track
      $publish
      $commit --author 'Jane Doe <jane@example.org>'

      $mailmap --yes --push ../../r repo 2>>"EOE" != 0
        error: branch 'main' of '$~/repo' has unpushed commits
          info: push them first or omit --push
        EOE

      test -f repo/.mailmap == 1
    }

    : rejected
    :
    : Test that a push the upstream rejects is reported and that the commit
    : is kept.
    :
    {
      $upstream &remote.git/***
      $init repo &repo/***
      $commit --author 'jane <jane@example.org>'
      $track
      $publish

      # Advance the upstream behind the repository's back.
      #
      $g clone --quiet --branch main remote.git other &other/***
      $g -C other commit --quiet --allow-empty --message 'Other' \
        --author 'Jane Doe <jane@example.org>'
      $g -C other push --quiet

      $mailmap --yes --push ../../r repo 2>>~%EOE% != 0
        %.*%*
        %error: push of '.+repo' to 'origin' failed%
          info: the .mailmap commit is kept in branch 'main'
        EOE

      git -C repo log -1 --format='%s' >'Update .mailmap'
    }
  }}

  : all
  :
  {{
    # Create a repository in the specified directory with one commit of the
    # specified author.
    #
    repo = [cmdline] $g init --quiet --initial-branch=main

    : discover
    :
    : Test that the repositories under the directory are found, hidden ones
    : included, and that repositories inside a working tree and linked
    : worktrees are skipped.
    :
    {
      mkdir ws ws/sub ws/plain

      $repo ws/a &ws/a/***
      $g -C ws/a commit --quiet --allow-empty --message 'Commit' \
        --author 'jane <jane@example.org>'

      $repo ws/sub/b &ws/sub/b/***
      $g -C ws/sub/b commit --quiet --allow-empty --message 'Commit' \
        --author 'jane <jane@example.org>'

      $repo ws/.hidden &ws/.hidden/***
      $g -C ws/.hidden commit --quiet --allow-empty --message 'Commit' \
        --author 'jane <jane@example.org>'

      $repo ws/a/nested
      $g -C ws/a/nested commit --quiet --allow-empty --message 'Commit' \
        --author 'Stranger <stranger@example.net>'

      $g -C ws/a worktree add --quiet ../worktree &ws/worktree/***

      $* --all --yes ../../r ws 2>>~%EOE%
        %.*%*
        %warning: skipping linked worktree '.+/ws/worktree'%
        %.*%*
        EOE

      test -f ws/a/.mailmap
      test -f ws/sub/b/.mailmap
      test -f ws/.hidden/.mailmap
      test -f ws/a/nested/.mailmap == 1
      test -f ws/worktree/.mailmap == 1
    }

    : none
    :
    : Test that a directory without repositories is an error.
    :
    {
      mkdir ws
      $* --all ../../r ws 2>"error: no git repositories found under 'ws'" != 0
    }

    : failed
    :
    : Test that a failure in one repository leaves every repository unchanged.
    :
    {
      mkdir ws

      $repo ws/a &ws/a/***
      $g -C ws/a commit --quiet --allow-empty --message 'Commit' \
        --author 'Stranger <stranger@example.net>'

      $repo ws/b &ws/b/***
      $g -C ws/b commit --quiet --allow-empty --message 'Commit' \
        --author 'jane <jane@example.org>'

      $* --all --yes ../../r ws 2>>~%EOE% != 0
        %error: history of '.+/ws/a' has identities not in '../../r'%
          info: Stranger <stranger@example.net>
        error: 1 of 2 repositories failed, nothing changed
        EOE

      test -f ws/b/.mailmap == 1
    }

    : confirm
    :
    : Test that the update of every repository is confirmed once and that
    : declining leaves them all unchanged.
    :
    {
      mkdir ws

      $repo ws/a &ws/a/***
      $g -C ws/a commit --quiet --allow-empty --message 'Commit' \
        --author 'jane <jane@example.org>'

      $repo ws/b &ws/b/***
      $g -C ws/b commit --quiet --allow-empty --message 'Commit' \
        --author 'jane <jane@example.org>'

      $* --all ../../r ws <'n' 2>>:~%EOE% != 0
        %.*%*
        %update 2 \.mailmap files\? \[y/n\]: %
        EOE

      test -f ws/a/.mailmap == 1
      test -f ws/b/.mailmap == 1
    }

    : push
    :
    : Test that a rejected push does not prevent pushing the rest.
    :
    {
      mkdir ws

      $g init --quiet --bare a.git &a.git/***
      $g init --quiet --bare b.git &b.git/***

      $repo ws/a &ws/a/***
      $g -C ws/a commit --quiet --allow-empty --message 'Commit' \
        --author 'jane <jane@example.org>'
      $g -C ws/a remote add origin ../../a.git
      $g -C ws/a push --quiet --set-upstream origin main

      $repo ws/b &ws/b/***
      $g -C ws/b commit --quiet --allow-empty --message 'Commit' \
        --author 'jane <jane@example.org>'
      $g -C ws/b remote add origin ../../b.git
      $g -C ws/b push --quiet --set-upstream origin main

      # Advance the upstream of a behind its back.
      #
      $g clone --quiet --branch main a.git other &other/***
      $g -C other commit --quiet --allow-empty --message 'Other' \
        --author 'Jane Doe <jane@example.org>'
      $g -C other push --quiet

      $mailmap --all --yes --push ../../r ws 2>>~%EOE% != 0
        %.*%*
        %error: push of '.+/ws/a' to 'origin' failed%
          info: the .mailmap commit is kept in branch 'main'
        %.*%*
        EOE

      git -C b.git log -1 --format='%s' main >'Update .mailmap'
    }
  }}
}}
