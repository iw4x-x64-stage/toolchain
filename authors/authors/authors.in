#! /usr/bin/env bash

# Copyright (c) the IW4x authors (see the AUTHORS file).
# SPDX-License-Identifier: GPL-3.0-only WITH AdditionRef-IW4x-Exception-1.1

# Generate the AUTHORS file of git repositories from the identity register.
#
# AUTHORS lists everyone who contributed to a repository once, by their
# preferred name, in alphabetical order. The contributors are the people the
# identities (name and email) of the repository history belong to, the
# history identities being the commit authors and the Co-authored-by trailer
# values. Each is attributed to its person through the identity register,
# the same way mailmap(1) maps it.
#
# The identity register is a manifest list with one manifest per person:
#
#   : 1
#   name: Jane Doe
#   email: jane@example.org
#   alias: J. Doe <jane@old.example.org>
#   alias: <jdoe@example.com>
#   authors: email
#
# See mailmap(1) for the name, email, and alias values and the register
# rules. The authors value specifies how the person is listed:
#
#   name   By the preferred name. This is the default.
#   email  By the preferred name and email.
#   none   Not at all, for example, a bot.
#
# AUTHORS only grows. The people it already lists stay listed, whether or not
# the history carries them, so that credit carried over from elsewhere (for
# example, from the predecessor of a restarted repository) is never lost. An
# entry is attributed through the register the same way as a history
# identity, by its name and email or, without an email, by a name the
# register records for exactly one person. It is then written the way the
# register currently lists its person. So a person leaves AUTHORS only
# through 'authors: none'.
#
# Every history identity and every entry must be attributed and the people
# listed must be told apart by their entries. The AUTHORS file starts with a
# fixed preamble, which is followed by the entries, one per line, sorted
# case-insensitively in the bytewise order so that the order is the same on
# every machine.
#
# Options:
#
# --all|-a
#
#   Operate on every repository found under <dir> instead of the one it is in.
#   The search does not descend into a repository working tree, so nested
#   repositories (submodules, repositories checked out inside another one) are
#   never visited. Linked worktrees are skipped as well, since their
#   repository is visited through its main working tree.
#
#   All the repositories are prepared before any of them is changed, so a
#   failure in one leaves them all unchanged, and the changes are confirmed
#   once for all of them. A failure to push one of them does not prevent
#   pushing the rest.
#
# --no-commit
#
#   Don't commit the updated AUTHORS. By default, AUTHORS is committed and
#   only it is, whatever else is staged. The commit message lists the entries
#   the update adds and removes.
#
#   Note that the committer becomes one of the history identities and so the
#   identity register must attribute them for the next update to succeed.
#
# --push
#
#   Push the commit to the upstream of the current branch. To push exactly
#   this commit, the branch must not be ahead of its upstream before the
#   update.
#
# --show-push
#
#   Print the push command instead of executing it. This allows examining the
#   commit before pushing it. Note that the command is printed to stdout.
#
# --print-only
#
#   Print to stdout what would be done without actually doing anything.
#
# --yes|-y
#
#   Don't prompt for confirmation before updating AUTHORS.
#
# Arguments:
#
# <identities>  The identity register file.
#
# <dir>         A directory in the repository working tree or, with --all,
#               the directory to search for repositories. If not specified,
#               the current directory is assumed.
#
usage="usage: $0 [<options>] <identities> [<dir>]"

owd="$(pwd)"
trap "{ cd '$owd'; exit 1; }" ERR
set -o errtrace     # Trap in functions and subshells.
set -o pipefail     # Fail if any pipeline command fails.
shopt -s lastpipe   # Execute last pipeline command in the current shell.

@import libbutl.bash/manifest-parser@

function info () { echo "$*" 1>&2; }
function error () { info "error: $*"; exit 1; }

# Trace and run a command, making git diagnostics distinguishable from
# ours.
#
function run () # <cmd> <arg>...
{
  info "+ $*"
  "$@"
}

all=
commit=true
push=
show_push=
print_only=
yes=

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h|--help)
      info "$usage"
      info
      info "Options:"
      info "  --all|-a      Operate on every repository found under <dir>."
      info "  --no-commit   Don't commit the updated AUTHORS."
      info "  --push        Push the commit to the upstream."
      info "  --show-push   Print the push command instead of executing it."
      info "  --print-only  Print what would be done without doing anything."
      info "  --yes|-y      Don't prompt for confirmation before updating."
      info "  --version     Print version and exit."
      info
      info "See the comments at the beginning of $0 for details."
      exit 0
      ;;
    --version)
      echo "authors @version@"
      exit 0
      ;;
    -a|--all)
      all=true
      shift
      ;;
    --no-commit)
      commit=
      shift
      ;;
    --push)
      push=true
      shift
      ;;
    --show-push)
      show_push=true
      shift
      ;;
    --print-only)
      print_only=true
      shift
      ;;
    -y|--yes)
      yes=true
      shift
      ;;
    # Catch invalid options.
    #
    -*)
      error "unknown option: $1"
      ;;
    # <identities> or end of options.
    #
    *)
      break
      ;;
  esac
done

if [[ "$#" -lt 1 || "$#" -gt 2 ]]; then
  error "$usage"
fi

if [[ "$push" && "$show_push" ]]; then
  error "both --push and --show-push specified"
fi

if [[ ! "$commit" ]]; then
  if [[ "$push" ]]; then
    error "--push specified with --no-commit"
  fi

  if [[ "$show_push" ]]; then
    error "--show-push specified with --no-commit"
  fi
fi

identities="$1"

if [[ ! -f "$identities" ]]; then
  error "'$identities' does not exist or is not a file"
fi

dir="${2:-$owd}"
dir="${dir%/}"

if [[ ! -d "$dir" ]]; then
  error "'$dir' does not exist or is not a directory"
fi

if ! command -v git >/dev/null; then
  error "unable to execute git: command not found"
fi

# Make sure that git commands fail instead of prompting for
# authentication and don't run maintenance tasks or start daemons.
#
# Note that we keep the credential helpers, since that is how an HTTPS
# push authenticates without a prompt.
#
export GIT_TERMINAL_PROMPT=0

val="\
'maintenance.autoDetach=false' \
'gc.autoDetach=false' \
'core.fsmonitor=false'"

if [[ -n "$GIT_CONFIG_PARAMETERS" ]]; then
  val="$val $GIT_CONFIG_PARAMETERS"
fi

export GIT_CONFIG_PARAMETERS="$val"

# The AUTHORS preamble. The entries follow it.
#
preamble="\
This file lists the IW4x authors, the collective name that the copyright
notices in the source files refer to.

The copyright for the code is held by the contributors of the code. The
revision history in the version control system is the primary source of
authorship information for copyright purposes. Every contributor is listed
below once, by their preferred name, in alphabetical order:
"

# The identity register.
#
# People and their aliases are indexed in the order they appear, with an
# empty name for an email alias. The maps are keyed by the lower-cased
# email (email_*) or by the lower-cased name and email joined with a
# newline, which neither can contain (identity_*, preferred_*).
#
people=0
person_name=()
person_email=()
person_authors=() # How the person is listed: name, email, or none.

aliases=0
alias_person=()
alias_name=()
alias_email=()

declare -A email_person=()     # Person of a preferred or aliased email.
declare -A email_spelling=()   # Email as spelled in the register.
declare -A identity_alias=()   # Alias of a name alias identity.
declare -A preferred_person=() # Person of a preferred identity.
declare -A name_people=()      # People with a preferred or alias name.

# Print the map key of the name and email.
#
function key () # <name> <email>
{
  local n="${1,,}"
  local e="${2,,}"

  echo "$n"$'\n'"$e"
}

# Split the identity in the '<name> <<email>>' or '<<email>>' form into
# the id_name and id_email variables, with id_name empty in the latter
# form. Return 1 if the identity is in neither form.
#
function parse_identity () # <identity>
{
  local re='^(([^<>]*[^<>[:space:]])[[:space:]]+)?[<]([^<>[:space:]]+)[>]$'

  if [[ ! "$1" =~ $re ]]; then
    return 1
  fi

  id_name="${BASH_REMATCH[2]}"
  id_email="${BASH_REMATCH[3]}"
}

# Add the name of the person to name_people, once.
#
function add_name () # <name> <person>
{
  local k="${1,,}"
  local ps="${name_people[$k]}"

  if [[ " $ps " != *" $2 "* ]]; then
    name_people["$k"]="${ps:+$ps }$2"
  fi
}

# Add the person and their aliases to the register. Fail if this
# violates the register rules.
#
function add_person () # <name> <email> <authors> <alias>...
{
  local n="$1"
  local e="$2"
  local l="$3"
  shift 3

  local name_re='^[^<>[:space:]]([^<>]*[^<>[:space:]])?$'
  local email_re='^[^<>@[:space:]]+@[^<>@[:space:]]+$'

  if [[ ! "$n" =~ $name_re ]]; then
    error "invalid name '$n' in '$identities'"
  fi

  if [[ ! "$e" =~ $email_re ]]; then
    error "invalid email '$e' of '$n' in '$identities'"
  fi

  local k="${e,,}"

  if [[ -n "${email_person[$k]+x}" ]]; then
    info "error: email '$e' belongs to multiple people in '$identities'"
    info "  info: '${person_name[${email_person[$k]}]}' and '$n'"
    exit 1
  fi

  local p="$people"

  person_name+=("$n")
  person_email+=("$e")
  person_authors+=("$l")
  add_name "$n" "$p"
  email_person["$k"]="$p"
  email_spelling["$k"]="$e"
  preferred_person["$(key "$n" "$e")"]="$p"

  local a o
  for a in "$@"; do
    if ! parse_identity "$a"; then
      error "invalid alias '$a' of '$n' in '$identities'"
    fi

    if [[ -z "$id_name" ]]; then

      # An email alias covers every name at the email.
      #
      k="${id_email,,}"

      if [[ -n "${email_person[$k]+x}" ]]; then
        o="${email_person[$k]}"

        if [[ "$o" -eq "$p" ]]; then
          error "alias '$a' of '$n' repeats their email in '$identities'"
        fi

        info "error: email '$id_email' belongs to multiple people in \
'$identities'"
        info "  info: '${person_name[$o]}' and '$n'"
        exit 1
      fi

      email_person["$k"]="$p"
      email_spelling["$k"]="$id_email"
    else
      if [[ "${id_email,,}" == "${e,,}" ]]; then
        error "alias '$a' of '$n' is covered by their email in '$identities'"
      fi

      k="$(key "$id_name" "$id_email")"

      if [[ -n "${identity_alias[$k]+x}" ]]; then
        o="${alias_person[${identity_alias[$k]}]}"

        info "error: alias '$a' belongs to multiple people in '$identities'"
        info "  info: '${person_name[$o]}' and '$n'"
        exit 1
      fi

      identity_alias["$k"]="$aliases"
      add_name "$id_name" "$p"
    fi

    alias_person+=("$p")
    alias_name+=("$id_name")
    alias_email+=("$id_email")
    aliases=$((aliases + 1))
  done

  people=$((people + 1))
}

# Load the identity register. Fail if it violates the register rules.
#
function load_identities ()
{
  local n v
  local name email authors named mailed listed relisted started end
  local as=()

  butl_manifest_parser_start "$identities"

  # The version pair (an empty name) that opens each manifest in the
  # list closes the person before it, and the end of the list closes the
  # last one.
  #
  while true; do
    if IFS=: read -ru "$butl_manifest_parser_ofd" -d '' n v; then
      end=
    else
      n=
      end=true
    fi

    if [[ -z "$n" ]]; then
      if [[ "$started" ]]; then
        if [[ ! "$named" ]]; then
          error "person without name in '$identities'"
        fi

        if [[ ! "$mailed" ]]; then
          error "person '$name' without email in '$identities'"
        fi

        if [[ "$relisted" ]]; then
          error "person '$name' has multiple authors values in '$identities'"
        fi

        case "$authors" in
          name|email|none)
            ;;
          *)
            error "invalid authors value '$authors' of '$name' in \
'$identities'"
            ;;
        esac

        add_person "$name" "$email" "$authors" "${as[@]}"
      fi

      if [[ "$end" ]]; then
        break
      fi

      name= email= named= mailed= started=
      authors=name listed= relisted=
      as=()
      continue
    fi

    started=true

    case "$n" in
      name)
        if [[ "$named" ]]; then
          error "person '$name' has multiple names in '$identities'"
        fi

        name="$v"
        named=true
        ;;
      email)
        if [[ "$mailed" ]]; then
          error "person with email '$email' has multiple emails in \
'$identities'"
        fi

        email="$v"
        mailed=true
        ;;
      alias)
        as+=("$v")
        ;;
      authors)
        if [[ "$listed" ]]; then
          relisted=true
        fi

        authors="$v"
        listed=true
        ;;
      *)
        error "unknown value '$n' in '$identities'"
        ;;
    esac
  done

  butl_manifest_parser_finish

  # Check the name aliases against the complete register.
  #
  # Note that an email alias of one person and a name alias of another
  # may refer to the same email. This is how two people who committed
  # with a shared email are told apart (and git resolves it the same
  # way).
  #
  local i p k a
  for ((i = 0; i != aliases; ++i)); do
    if [[ -z "${alias_name[$i]}" ]]; then
      continue
    fi

    p="${alias_person[$i]}"
    a="${alias_name[$i]} <${alias_email[$i]}>"

    # A name alias takes precedence over an email, so one that matches
    # another person's preferred identity would take their commits away
    # from them.
    #
    k="$(key "${alias_name[$i]}" "${alias_email[$i]}")"

    if [[ -n "${preferred_person[$k]+x}" ]]; then
      info "error: alias '$a' of '${person_name[$p]}' is the preferred \
identity of '${person_name[${preferred_person[$k]}]}'"
      info "  info: in '$identities'"
      exit 1
    fi

    k="${alias_email[$i],,}"

    if [[ -n "${email_person[$k]+x}" && "${email_person[$k]}" -eq "$p" ]]
    then
      error "alias '$a' of '${person_name[$p]}' is covered by their email \
alias in '$identities'"
    fi
  done
}

# Print the distinct identities the repository history carries, one per
# line in the bytewise order. A repository without commits carries none.
#
function history_identities () # <repo>
{
  local r="$1"

  if ! git -C "$r" rev-parse --verify --quiet HEAD >/dev/null; then
    return 0
  fi

  {
    git -C "$r" log --format='%an <%ae>' HEAD
    git -C "$r" log \
      --format='%(trailers:key=Co-authored-by,valueonly,unfold)' HEAD
  } | sed -e '/^$/d' | LC_ALL=C sort -u
}

# Print the person the identity belongs to, matching it the same way git
# applies a .mailmap entry to it. Return 1 if the register does not
# attribute it.
#
function identity_person () # <name> <email>
{
  local k
  k="$(key "$1" "$2")"

  if [[ -n "${identity_alias[$k]+x}" ]]; then
    echo "${alias_person[${identity_alias[$k]}]}"
  elif [[ -n "${email_person[${2,,}]+x}" ]]; then
    echo "${email_person[${2,,}]}"
  else
    return 1
  fi
}

# Print the entry the person is listed with in AUTHORS.
#
function entry () # <person>
{
  local p="$1"

  if [[ "${person_authors[$p]}" == "email" ]]; then
    echo "${person_name[$p]} <${person_email[$p]}>"
  else
    echo "${person_name[$p]}"
  fi
}

# The repositories.
#
# The repositories are indexed in the order they are found. Each has its
# own subdirectory of the temporary directory named after its index.
#
repos=()

repo_failed=()     # Preparing or updating the repository failed.
repo_state=()      # AUTHORS state: current, stale, or absent.
repo_identities=() # Number of history identities.
repo_listed=()     # Number of people listed.
repo_branch=()     # Branch, remote, and upstream branch to push to.
repo_remote=()
repo_merge=()

# Report the error for the repository and mark it as failed. Each
# argument after the first is printed as an info line.
#
function repo_error () # <index> <text> [<info>...]
{
  local i="$1"

  info "error: $2"
  shift 2

  local s
  for s in "$@"; do
    info "  info: $s"
  done

  repo_failed[$i]=true
}

# Add the repository working tree roots found under the directory to
# repos. Do not descend into a working tree and skip linked worktrees.
#
# Note that a working tree root carries .git, which is a directory or,
# for a linked worktree or a submodule, a file.
#
function find_repositories () # <dir>
{
  local d="$1"

  if [[ -e "$d/.git" ]]; then
    local t
    if t="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" &&
       [[ "$t" == "$(realpath "$d")" ]]; then

      local g c
      g="$(git -C "$d" rev-parse --absolute-git-dir)"
      c="$(git -C "$d" rev-parse --path-format=absolute --git-common-dir)"

      if [[ "$g" == "$c" ]]; then
        repos+=("$t")
      else
        info "warning: skipping linked worktree '$t'"
      fi

      return 0
    fi
  fi

  # Note that hidden directories are searched as well, since a
  # repository can be one (for example, .github).
  #
  local s
  for s in "$d"/* "$d"/.[!.]* "$d"/..?*; do
    if [[ -d "$s" && ! -L "$s" && "$(basename "$s")" != ".git" ]]; then
      find_repositories "$s"
    fi
  done
}

# Add the repository working tree roots found under the directory to
# repos. Do not descend into a working tree and skip linked worktrees.
#
# Note that a working tree root carries .git, which is a directory or,
# for a linked worktree or a submodule, a file.
#
function find_repositories () # <dir>
{
  local d="$1"

  if [[ -e "$d/.git" ]]; then
    local t
    if t="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" &&
       [[ "$t" == "$(realpath "$d")" ]]; then

      local g c
      g="$(git -C "$d" rev-parse --absolute-git-dir)"
      c="$(git -C "$d" rev-parse --path-format=absolute --git-common-dir)"

      if [[ "$g" == "$c" ]]; then
        repos+=("$t")
      else
        info "warning: skipping linked worktree '$t'"
      fi

      return 0
    fi
  fi

  # Note that hidden directories are searched as well, since a
  # repository can be one (for example, .github).
  #
  local s
  for s in "$d"/* "$d"/.[!.]* "$d"/..?*; do
    if [[ -d "$s" && ! -L "$s" && "$(basename "$s")" != ".git" ]]; then
      find_repositories "$s"
    fi
  done
}

# Print the entries of the AUTHORS file, one per line, skipping blank
# lines. Return 1 if the file does not start with the preamble.
#
function entries () # <file>
{
  local f="$1"
  local n
  n="$(printf '%s' "$preamble" | wc -l)"

  if [[ "$(head -n "$n" "$f")" != "${preamble%$'\n'}" ]]; then
    return 1
  fi

  tail -n "+$((n + 1))" "$f" | sed -e '/^[[:space:]]*$/d'
}

# Generate the repository AUTHORS into the file and record the numbers of
# its history identities and of the people it lists. Mark the repository
# as failed if the register does not attribute some history identity or
# entry, or if the people listed cannot be told apart.
#
function generate () # <index> <file>
{
  local i="$1"
  local f="$2"
  local r="${repos[$i]}"
  local a="$r/AUTHORS"

  declare -A ps=() # People to list.

  local us=() # Unattributed identities.
  local hs=()
  history_identities "$r" | readarray -t hs

  repo_identities[$i]="${#hs[@]}"

  local h p
  for h in "${hs[@]}"; do

    # The Co-authored-by value is recorded as written, so it may not be
    # an identity at all, and then there is no person to credit.
    #
    if ! parse_identity "$h" || [[ -z "$id_name" ]]; then
      info "warning: '$h' in the history of '$r' is not an identity"
      continue
    fi

    if p="$(identity_person "$id_name" "$id_email")"; then
      ps["$p"]=true
    else
      us+=("$h")
    fi
  done

  if [[ "${#us[@]}" -ne 0 ]]; then
    repo_error "$i" "history of '$r' has identities not in '$identities'" \
      "${us[@]}"
    return 0
  fi

  # Keep the people AUTHORS already lists.
  #
  if [[ -f "$a" ]]; then
    local es=()
    if ! entries "$a" | readarray -t es; then
      repo_error "$i" "'$a' does not start with the AUTHORS preamble" \
        "put the entries to keep after the preamble or remove the file"
      return 0
    fi

    local e q
    for e in "${es[@]}"; do
      if parse_identity "$e" && [[ -n "$id_name" ]]; then
        if p="$(identity_person "$id_name" "$id_email")"; then
          ps["$p"]=true
          continue
        fi
      else
        q="${name_people[${e,,}]}"

        if [[ "$q" == *" "* ]]; then
          local ns=()
          for p in $q; do
            ns+=("$(entry "$p")")
          done

          repo_error "$i" "entry '$e' in '$a' matches multiple people in \
'$identities'" "${ns[@]}" "add their emails to the entries to tell them apart"
          return 0
        fi

        if [[ -n "$q" ]]; then
          ps["$q"]=true
          continue
        fi
      fi

      us+=("$e")
    done

    if [[ "${#us[@]}" -ne 0 ]]; then
      repo_error "$i" "'$a' has entries not in '$identities'" "${us[@]}"
      return 0
    fi
  fi

  # Write the entries of the people listed, sorted.
  #
  local ls=()
  for p in "${!ps[@]}"; do
    if [[ "${person_authors[$p]}" != "none" ]]; then
      ls+=("$(entry "$p")")
    fi
  done

  repo_listed[$i]="${#ls[@]}"

  local ss=()
  if [[ "${#ls[@]}" -ne 0 ]]; then
    printf '%s\n' "${ls[@]}" | LC_ALL=C sort -f | readarray -t ss
  fi

  # Two people with the same name are only told apart by their emails.
  #
  local ds=()
  if [[ "${#ss[@]}" -ne 0 ]]; then
    printf '%s\n' "${ss[@]}" | LC_ALL=C uniq -di | readarray -t ds
  fi

  if [[ "${#ds[@]}" -ne 0 ]]; then
    repo_error "$i" "people listed in '$a' cannot be told apart" "${ds[@]}" \
      "list them with 'authors: email' in '$identities'"
    return 0
  fi

  {
    printf '%s\n' "$preamble"

    if [[ "${#ss[@]}" -ne 0 ]]; then
      printf '%s\n' "${ss[@]}"
    fi
  } >"$f"
}

# Generate the repository AUTHORS and establish its state. If it is to be
# updated, also establish that it can be committed and pushed. Mark the
# repository as failed if any of this fails.
#
function prepare () # <index>
{
  local i="$1"
  local r="${repos[$i]}"
  local a="$r/AUTHORS"

  mkdir "$tmp_dir/$i"

  # Installing AUTHORS replaces the file, which would turn a symbolic link
  # into a copy of its target.
  #
  if [[ -L "$a" ]]; then
    repo_error "$i" "'$a' is a symbolic link" \
      "run authors in the repository it refers to"
    return 0
  fi

  generate "$i" "$tmp_dir/$i/AUTHORS"

  if [[ "${repo_failed[$i]}" ]]; then
    return 0
  fi

  if [[ ! -f "$a" ]]; then
    repo_state[$i]="absent"
  elif cmp -s "$tmp_dir/$i/AUTHORS" "$a"; then
    repo_state[$i]="current"
  else
    repo_state[$i]="stale"
  fi

  if [[ "${repo_state[$i]}" == "current" ]]; then
    return 0
  fi

  # Refuse to replace uncommitted changes to AUTHORS, since they would be
  # lost, and make sure the commit can be made before we change anything.
  #
  if [[ -n "$(git -C "$r" status --porcelain -- AUTHORS)" ]]; then
    repo_error "$i" "'$a' has uncommitted changes"
    return 0
  fi

  if [[ "$commit" ]] && ! git -C "$r" var GIT_COMMITTER_IDENT \
                            >/dev/null 2>&1; then
    repo_error "$i" "no git identity to commit to '$r' with" \
      "configure user.name and user.email"
    return 0
  fi

  if [[ ! "$push" && ! "$show_push" ]]; then
    return 0
  fi

  # Establish where the commit is pushed to.
  #
  # The upstream is pushed to explicitly, whatever push.default says.
  # Since git pushes every commit the branch has that its upstream does
  # not, the branch must not be ahead of its upstream, so the push
  # carries exactly our commit.
  #
  local b rem mg n

  if ! b="$(git -C "$r" symbolic-ref --quiet --short HEAD)"; then
    repo_error "$i" "HEAD of '$r' is detached, so there is no branch to push" \
      "check out a branch or omit --push"
    return 0
  fi

  rem="$(git -C "$r" config --get "branch.$b.remote" || true)"
  mg="$(git -C "$r" config --get "branch.$b.merge" || true)"

  if [[ -z "$rem" || -z "$mg" ]]; then
    repo_error "$i" "branch '$b' of '$r' has no upstream to push to" \
      "set one with 'git branch --set-upstream-to' or omit --push"
    return 0
  fi

  if ! n="$(git -C "$r" rev-list --count '@{upstream}..HEAD' 2>/dev/null)"
  then
    repo_error "$i" "upstream of branch '$b' of '$r' is not fetched" \
      "run 'git fetch $rem' or omit --push"
    return 0
  fi

  if [[ "$n" -ne 0 ]]; then
    repo_error "$i" "branch '$b' of '$r' has unpushed commits" \
      "push them first or omit --push"
    return 0
  fi

  repo_branch[$i]="$b"
  repo_remote[$i]="$rem"
  repo_merge[$i]="$mg"
}

# Install the generated AUTHORS into the repository and, if requested,
# commit and push it. Mark the repository as failed if the push fails.
#
function update () # <index>
{
  local i="$1"
  local r="${repos[$i]}"
  local a="$r/AUTHORS"
  local d="$tmp_dir/$i"

  # Compose the commit message, listing the entries the update adds and
  # removes in the message body.
  #
  if [[ "$commit" ]]; then
    if [[ -f "$a" ]]; then
      entries "$a" | LC_ALL=C sort >"$d/old"
    else
      true >"$d/old"
    fi

    entries "$d/AUTHORS" | LC_ALL=C sort >"$d/new"

    local body
    body="$(
      LC_ALL=C comm -13 "$d/old" "$d/new" | sed -e 's/^/  add    /'
      LC_ALL=C comm -23 "$d/old" "$d/new" | sed -e 's/^/  remove /'
    )"

    {
      echo "Update AUTHORS"

      if [[ -n "$body" ]]; then
        echo
        echo "$body"
      fi
    } >"$d/message"
  fi

  # Install AUTHORS with a single rename, so no reader observes it
  # partially written.
  #
  run cp "$d/AUTHORS" "$a.tmp"
  run mv -f "$a.tmp" "$a"

  if [[ "$commit" ]]; then
    run git -C "$r" add -- AUTHORS >&2
    run git -C "$r" commit --quiet --only --file "$d/message" -- AUTHORS >&2
  fi

  # Push the commit. If this fails (for example, because the upstream
  # has moved on), the commit stays and can be pushed once the branch is
  # brought up to date.
  #
  if [[ "$push" ]]; then
    if ! run git -C "$r" push --quiet "${repo_remote[$i]}" \
         "HEAD:${repo_merge[$i]}" >&2; then
      repo_error "$i" "push of '$r' to '${repo_remote[$i]}' failed" \
        "the AUTHORS commit is kept in branch '${repo_branch[$i]}'"
    fi
  fi
}

tmp_dir="$(mktemp -d)"
trap "{ rm -rf '$tmp_dir'; }" EXIT

# Establish the repositories.
#
if [[ "$all" ]]; then
  find_repositories "$dir"

  if [[ "${#repos[@]}" -eq 0 ]]; then
    error "no git repositories found under '$dir'"
  fi
else
  if ! r="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"; then
    error "'$dir' is not inside a git working tree"
  fi

  repos=("$r")
fi

load_identities

# Prepare every repository before changing any, so that a failure in one
# leaves them all unchanged.
#
failed=0

for ((i = 0; i != "${#repos[@]}"; ++i)); do
  prepare "$i"

  if [[ "${repo_failed[$i]}" ]]; then
    failed=$((failed + 1))
  fi
done

if [[ "$failed" -ne 0 ]]; then
  if [[ "${#repos[@]}" -gt 1 ]]; then
    info "error: $failed of ${#repos[@]} repositories failed, nothing changed"
  fi

  exit 1
fi

# Print what the update is going to do: the repositories whose AUTHORS is
# up to date and, for each of the rest, where the commit is pushed to and
# the changes to AUTHORS. Also collect the latter in pending.
#
pending=()

function plan ()
{
  local i r

  for ((i = 0; i != "${#repos[@]}"; ++i)); do
    r="${repos[$i]}"

    if [[ "${repo_state[$i]}" == "current" ]]; then
      echo "'$r/AUTHORS' is up to date"
      continue
    fi

    pending+=("$i")

    echo
    echo "repository:         $r"
    echo "history identities: ${repo_identities[$i]}"
    echo "people listed:      ${repo_listed[$i]}"

    if [[ "$push" || "$show_push" ]]; then
      echo "push to:            ${repo_remote[$i]} \
${repo_merge[$i]#refs/heads/}"
    fi

    echo

    if [[ "${repo_state[$i]}" == "absent" ]]; then
      sed -e 's/^/+/' "$tmp_dir/$i/AUTHORS"
    else
      diff -u --label "a/AUTHORS" --label "b/AUTHORS" \
        "$r/AUTHORS" "$tmp_dir/$i/AUTHORS" || true
    fi
  done
}

if [[ "$print_only" ]]; then
  plan
  exit 0
fi

# Show the changes and ask for confirmation.
#
plan 1>&2

if [[ "${#pending[@]}" -eq 0 ]]; then
  exit 0
fi

info

if [[ "${#pending[@]}" -eq 1 ]]; then
  question="update '${repos[${pending[0]}]}/AUTHORS'?"
else
  question="update ${#pending[@]} AUTHORS files?"
fi

while [[ ! "$yes" ]]; do
  printf '%s [y/n]: ' "$question" 1>&2

  if ! read opt; then
    info
    error "unable to read answer, use --yes to update without asking"
  fi

  case "$opt" in
    y) yes=true ;;
    n) exit 1   ;;
  esac
done

# Update. A failure to push one repository does not prevent updating the
# rest.
#
for i in "${pending[@]}"; do
  update "$i"

  if [[ "${repo_failed[$i]}" ]]; then
    failed=$((failed + 1))
  fi
done

# Print the push commands, quoted so that they can be executed as
# printed.
#
if [[ "$show_push" ]]; then
  for i in "${pending[@]}"; do
    printf '%q ' git -C "${repos[$i]}" push "${repo_remote[$i]}"
    printf '%q\n' "HEAD:${repo_merge[$i]}"
  done
fi

if [[ "$failed" -ne 0 ]]; then
  exit 1
fi
